# Runtime overrides for the Tessaro kiosk.
#
# The build-time defaults live in /usr/lib/tessaro-kiosk/tessaro-kiosk.env.
# Both tessaro-kiosk.service and tessaro-agent.service read that file first and
# this one second, so anything set here wins, and the browser and its
# supervisor can never disagree about what the kiosk URL is. Apply a change
# with:
#
#     systemctl restart tessaro-kiosk tessaro-agent
#
# This file is left entirely commented out on purpose. /etc is an overlayfs
# whose upper layer is the /data partition, so the first write to this path
# shadows the image's copy for good and no later image could move a default
# again.
#
# It is parsed as a systemd NAME=value environment file, not by a shell: plain
# NAME=value, optional quotes (which are stripped), and # comments. No command
# substitution, no exports.

# URL the kiosk shows.
#
# The image default is http://127.0.0.1/, the self-test page served by nginx
# from /usr/share/tessaro-selftest. Deploying a device means pointing this at
# the site it is there to show:
#
#KIOSK_URL="https://www.freevision.sk"
#
# Careful if you point this at an origin the image was not built for. The
# device-API grants in /etc/chromium/policies/managed/10-tessaro.json list the
# origins baked in at build time - TESSARO_KIOSK_URL's and the self-test's -
# so Web Serial and WebHID silently stop working for anything else until that
# file is edited too. Same-origin sub-pages, query strings and in-page routing
# are all fine. Building the image with the right TESSARO_KIOSK_URL avoids the
# problem entirely.
#
# To get back to the self-test page on a deployed device, comment the line
# above out again, or set it explicitly:
#
#KIOSK_URL="http://127.0.0.1/"

# Working through the self-test page by hand? Set KIOSK_REFRESH_INTERVAL to 0
# first - it is in the navigation section further down. The agent re-navigates
# on that timer whether or not anything is wrong, which closes any serial port
# the page has open and wipes every value typed into it.

# Where the agent finds Chromium's DevTools protocol. Loopback only, which is
# where the browser listens and where it stays.
#KIOSK_CDP_URL="http://127.0.0.1:9222"

# --- the browser -----------------------------------------------------------
#
# Read by tessaro-kiosk.service only. Apply with
# `systemctl restart tessaro-kiosk`.

# Extra Chromium flags, appended after the fixed set in the unit. systemd
# splits this at whitespace, so several flags on one line work. It can only
# add - there is no way to remove a flag the unit already passes.
#
# --disable-pinch is the common one on a touch panel: it stops two fingers
# zooming the page out of the layout the site intends. It is not in the unit's
# fixed set precisely because Chromium 147 has no --enable-pinch to undo it.
#KIOSK_CHROMIUM_ARGS_EXTRA="--disable-pinch"

# Touch event feature detection: auto | enabled | disabled.
#
# "auto" follows Weston's wl_seat, which is right almost always. Force it to
# "enabled" if the page's own feature detection has to be true before any
# device is warm - the seat capability can arrive after the first page load -
# and to "disabled" on a panel whose driver reports touch you do not want the
# site to see.
#KIOSK_TOUCH="auto"

# Chromium base::Feature names, comma separated.
#
# Web Bluetooth is *experimental* on desktop Linux - Chromium ships it enabled
# on Android, ChromeOS, macOS and Windows and not here - so navigator.bluetooth
# does not exist until this names it. WebBluetoothNewPermissionsBackend is what
# makes a pairing survive a restart and exposes getDevices(); without it, every
# boot needs the chooser again.
#
# Note there is no policy anywhere in Chromium that pre-grants a Bluetooth
# device, so even with this set a technician has to pick the peripheral in the
# chooser once per device. Serial, HID and USB do not need that - see the
# policy file.
#KIOSK_ENABLE_FEATURES="WebBluetooth,WebBluetoothNewPermissionsBackend"

# --- the display -----------------------------------------------------------

# Weston output scale, for a panel where the default guess is wrong.
#
# Empty means auto: 2 above 3400px wide, 1 below. "none" disables the whole
# mechanism and leaves Weston at its own default. Integers only; Weston 13 has
# no fractional scaling and Chromium cannot scale itself on Wayland, so this is
# the only lever. Set it to 2 on a 4K panel that is read from across a room, or
# to 1 on one that is read from a desk.
#
# Unlike most of this file, this is consumed by the compositor. Apply it with
# `systemctl restart weston`, which takes the browser and the agent with it.
#
# For per-connector control instead, put an [output] section in
# /etc/xdg/weston/weston.ini by hand - the generator leaves any connector
# already named there alone. `journalctl -t tessaro-weston-config` lists the
# connector names, and everything else the generator decided.
#KIOSK_SCALE="2"

# On-screen keyboard: auto | always | never. Default auto.
#
# auto means: show Weston's virtual keyboard when no hardware keyboard is
# attached, hide it when one is. Only USB and Bluetooth devices that udev tags
# ID_INPUT_KEYBOARD count, so the AT keyboard most x86 boards expose with
# nothing plugged into it does not suppress the keyboard. A VM does: runqemu
# gives the guest a USB keyboard, so auto hides the panel there and testing it
# under QEMU means setting this to "always".
#
# Set "always" on a touch device that also has something keyboard-shaped on the
# USB bus - a barcode scanner, an RFID reader and a KVM dongle all enumerate as
# HID keyboards and all make auto decide a keyboard is present. Set "never" on
# a device where nobody is ever meant to type.
#
# The keyboard itself is weston-keyboard, Weston's own: QWERTY, a numeric pad
# for number and digit fields, touch and mouse both. It draws above the
# fullscreen browser and does not move the page, so a field at the very bottom
# can end up behind it - a site that expects touch input should keep its inputs
# out of the bottom of the viewport, or bring its own keyboard.
#
# Consumed by the compositor, like KIOSK_SCALE: apply with
# `systemctl restart weston`, and note that the decision is made at that moment
# only. Plugging a keyboard in later changes nothing until the next restart.
# `journalctl -t tessaro-weston-config` prints what it decided and what it
# found - not `journalctl -u weston`, which does not carry ExecStartPre output.
#
# For full manual control, put an [input-method] section in
# /etc/xdg/weston/weston.ini by hand - the generator leaves one already there
# alone, whatever KIOSK_OSK says.
#KIOSK_OSK="always"

# --- the agent: offline page -----------------------------------------------
#
# Shown while the site is unreachable. Precedence, first match wins:
#
#   1. KIOSK_OFFLINE_URL          navigated to verbatim - any URI, including a
#                                 page on another host. Note that a remote page
#                                 is only reachable when the failure is upstream
#                                 of it; for one that always renders, use 2 or 3.
#                                 The value "none" disables navigating away
#                                 entirely, for a site that handles its own
#                                 offline state in a service worker.
#   2. /data/kiosk/offline.html   drop a file on the data partition. It is used
#                                 as-is, with no substitution, and takes effect
#                                 on the next failure with no restart.
#   3. /usr/share/tessaro-kiosk/offline.html   the shipped default.
#
# The agent stages the chosen file into /run/tessaro-kiosk and navigates
# Chromium to it as file://. Diagnostics are deliberately not on the page -
# they are in the journal:
#
#     journalctl -u tessaro-agent
#
#KIOSK_OFFLINE_URL="https://status.example.com/kiosk"
#KIOSK_OFFLINE_PAGE="/data/kiosk/offline.html"

# --- probe -----------------------------------------------------------------
#
# What the agent fetches to decide whether the site is up. Empty means
# KIOSK_URL itself. Set it when the site has a cheap health endpoint, and set it
# always when KIOSK_URL is not an http(s) URL - a file:// or data: kiosk cannot
# be probed, and the agent drops to refresh-only without it.
#KIOSK_PROBE_URL="https://www.freevision.sk/"

# Seconds between probes while healthy, and while down.
#KIOSK_PROBE_INTERVAL="30"
#KIOSK_PROBE_INTERVAL_FAIL="10"

# Timeouts for one probe. Keep the total well under KIOSK_PROBE_INTERVAL.
#KIOSK_PROBE_CONNECT_TIMEOUT="5"
#KIOSK_PROBE_TIMEOUT="10"

# Consecutive failed probes before the offline page is shown. Riding out one
# blip stops a single dropped packet blanking a public screen.
#KIOSK_FAIL_THRESHOLD="2"

# --- navigation ------------------------------------------------------------
#
# Seconds between re-opening the kiosk URL while healthy. This is the periodic
# refresh. 0 disables it.
#
# Set it to 0 for the duration of a manual pass over the self-test page: a
# reload halfway through closes any serial port the page has open and wipes
# every value typed into it. Put it back afterwards - on a deployed site the
# periodic reload is what recovers a page that has quietly gone stale.
#KIOSK_REFRESH_INTERVAL="600"

# Seconds between re-opening the offline page while down. 0 shows it once.
#KIOSK_OFFLINE_REFRESH="300"

# --- recovery --------------------------------------------------------------
#
# Failed CDP liveness checks before the browser is restarted - this one catches
# Chromium being dead or wedged, independently of the network. The restart goes
# through systemd's D-Bus API (RestartUnit), so it is exactly what systemctl
# restart would do.
#KIOSK_PING_FAILS="3"

# Failed probes before the browser is restarted once, to clear a wedged
# renderer. 0 disables it. The restart happens at most once per outage, and
# never more often than KIOSK_RESTART_BACKOFF seconds.
#KIOSK_RESTART_AFTER="40"
#KIOSK_RESTART_BACKOFF="300"

# --- staying on the site ---------------------------------------------------
#
# Bring the browser back to KIOSK_URL when it ends up somewhere else - someone
# followed a link, or the page opened one. The comparison is by *origin*
# (scheme, host and port), so the site's own sub-pages, query strings and
# in-page routing are left alone; only leaving the site counts. The return is
# logged, so the journal shows where it had gone.
#
# Set to 0 if the site legitimately sends visitors to another host - a payment
# provider, an external booking system - and you would rather they could get
# back. It is also inert when KIOSK_URL is not http(s), since a data: or file:
# URL has no origin to compare against.
#KIOSK_ENFORCE_ORIGIN="1"

# Set to 0 to park the agent without masking the unit - useful while debugging
# a page, where the periodic refresh would keep stealing the view.
#KIOSK_AGENT_ENABLE="1"

# Keep a blank line at the end. Appending to this file with >> is the obvious
# way to set something from a script, and without a final newline the first
# appended line lands on the end of the comment above it - where systemd
# silently ignores it, because the line now starts with a #.
