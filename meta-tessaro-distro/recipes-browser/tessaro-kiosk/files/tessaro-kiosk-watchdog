#!/bin/sh
#
# Tessaro kiosk watchdog: probe the target URL, keep cog pointed at it, show a
# local offline page while it is unreachable, and restart the browser when it
# stops responding.
#
# POSIX sh only - this is busybox ash. No bash, no ruby, no python on a device.
#
# Why this exists: cog's control surface is write-only. It exports five
# stateless D-Bus actions (quit, previous, next, reload, open) and nothing that
# answers a question, so there is no way to ask what URL it is showing or
# whether the last load failed. Every decision here is therefore driven by an
# external probe plus this script's own bookkeeping. In particular we cannot
# detect cog's own error page - the hardcoded one with a "Try again" button that
# nobody can press on a screen with no input device - so the recovery for it is
# simply to re-navigate whenever a probe succeeds and we are not certain what is
# on screen.
#
# Why a loop and not a systemd timer: the intervals have to be settable from
# /etc/default/tessaro-kiosk, and a [Timer] section cannot read an
# EnvironmentFile - OnUnitActiveSec= is parsed when the unit is loaded. A timer
# design would have to generate a unit into /etc/systemd/system and reload, and
# /etc is an overlayfs upper on /data where the first write to a path shadows
# the image copy permanently. A loop also keeps the failure streak and the
# navigation state in shell variables instead of serialising them to /run on
# every invocation.
#
# set -u catches the typo class of bug. Deliberately no set -e: this is a long
# running loop and one transient failure must not terminate the service.

set -u

# --------------------------------------------------------------------------
# Configuration
#
# Everything arrives as environment variables, placed there by systemd from
# /usr/lib/tessaro-kiosk/tessaro-kiosk.env (build-time defaults) and
# /etc/default/tessaro-kiosk (the operator's overrides). The files are not
# sourced here on purpose: letting systemd parse them keeps one syntax and one
# precedence rule, and stops /etc/default/tessaro-kiosk being code that runs as
# root. Changes therefore need:
#
#     systemctl restart tessaro-kiosk-watchdog
#
# The := defaults below exist so the script is still runnable by hand.
# --------------------------------------------------------------------------

: "${KIOSK_URL:=}"
# Probe something other than KIOSK_URL when the kiosk itself is not an http(s)
# URL, or when the site has a cheaper health endpoint.
: "${KIOSK_PROBE_URL:=}"

# Probe cadence. Faster while down, because recovery latency is what a viewer
# actually experiences and a probe against a dead host costs nothing.
: "${KIOSK_PROBE_INTERVAL:=30}"
: "${KIOSK_PROBE_INTERVAL_FAIL:=10}"
: "${KIOSK_PROBE_CONNECT_TIMEOUT:=5}"
: "${KIOSK_PROBE_TIMEOUT:=10}"
# Ride out a single blip before putting the offline page on a public screen.
: "${KIOSK_FAIL_THRESHOLD:=2}"

# Navigation cadence, kept strictly separate from the probe cadence: probing
# often must not mean reloading often. Re-navigating on every probe would flash
# the screen every 30 seconds and read as a crash loop.
: "${KIOSK_REFRESH_INTERVAL:=600}"
: "${KIOSK_OFFLINE_REFRESH:=300}"

# The offline page. Precedence, first match wins:
#   1. KIOSK_OFFLINE_URL  - navigated to verbatim. "none" disables navigating
#                           away from the kiosk URL at all.
#   2. /data/kiosk/offline.html
#   3. /usr/share/tessaro-kiosk/offline.html  (shipped default)
: "${KIOSK_OFFLINE_URL:=}"
: "${KIOSK_OFFLINE_PAGE:=/data/kiosk/offline.html}"
: "${KIOSK_OFFLINE_PAGE_DEFAULT:=/usr/share/tessaro-kiosk/offline.html}"
: "${KIOSK_OFFLINE_DIR:=/run/tessaro-kiosk}"
# /run is tmpfs, i.e. RAM the web process needs. An oversized "offline page"
# with an embedded video is refused rather than staged.
: "${KIOSK_OFFLINE_MAX_BYTES:=262144}"

# Escalation. Two independent triggers - see the main loop.
: "${KIOSK_PING_FAILS:=3}"
: "${KIOSK_RESTART_AFTER:=40}"
: "${KIOSK_RESTART_BACKOFF:=300}"

: "${KIOSK_UNIT:=tessaro-kiosk.service}"
: "${KIOSK_WATCHDOG_ENABLE:=1}"
: "${KIOSK_DEBUG:=0}"

COG_NAME=com.igalia.Cog
COG_PATH=/com/igalia/Cog
# Must match --dir-handler=tessaro:${KIOSK_OFFLINE_DIR} in tessaro-kiosk.service.
OFFLINE_URI="tessaro:///index.html"

# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------

# stderr is the journal, under this unit's SyslogIdentifier.
log() { printf '%s\n' "$*" >&2; }
dbg() { [ "$KIOSK_DEBUG" = "1" ] && log "$*"; return 0; }

running=1
trap 'running=0' TERM INT HUP

# Sleep in short slices: ash only runs a trap between commands, so a single
# "sleep 600" would sit through systemd's stop timeout and then take a SIGKILL.
nap() {
    _left=$1
    while [ "$_left" -gt 0 ] && [ "$running" -eq 1 ]; do
        if [ "$_left" -gt 2 ]; then
            sleep 2
            _left=$((_left - 2))
        else
            sleep "$_left"
            _left=0
        fi
    done
}

now() { date +%s 2>/dev/null || echo 0; }

# --------------------------------------------------------------------------
# Talking to cog
#
# This is the exact wire call cogctl makes: org.gtk.Actions.Activate takes the
# action name, an array of variant parameters, and platform data. busctl rather
# than cogctl because busctl ships with systemd and is therefore always present,
# and because cogctl's own "ping" is broken in 0.18.5 - launcher/cogctl.c:57-59
# tests the GError** instead of the connection, so it always reports failure
# without ever contacting the bus. --timeout bounds the block if cog's main loop
# is wedged rather than dead.
# --------------------------------------------------------------------------

cog_open() {
    busctl --system --timeout=5 call \
        "$COG_NAME" "$COG_PATH" org.gtk.Actions Activate \
        'sava{sv}' open 1 s "$1" 0 >/dev/null 2>&1
}

# Proves the process is alive and its main loop is turning. It proves nothing
# about the web process - that is what --webprocess-failure=exit is for.
cog_alive() {
    busctl --system --timeout=5 call \
        "$COG_NAME" "$COG_PATH" org.freedesktop.DBus.Peer Ping >/dev/null 2>&1
}

# A restart of the browser is invisible on the control interface: the fresh
# process opens the URL from its own ExecStart, and if that load fails it sits
# on cog's un-dismissable error page - which nothing in the D-Bus surface can
# report. Watching MainPID is the cheap way to notice, so that the next cycle
# re-navigates instead of waiting out a refresh timer. It catches restarts we
# did not order ourselves, from systemd's Restart= or from a Ctrl-W.
last_mainpid=0
cog_changed=0
check_cog_pid() {
    cog_changed=0
    _pid=$(systemctl show -p MainPID --value "$KIOSK_UNIT" 2>/dev/null) || _pid=0
    case "$_pid" in ''|*[!0-9]*) _pid=0 ;; esac
    [ "$_pid" -eq 0 ] && return 0
    if [ "$_pid" -ne "$last_mainpid" ]; then
        # The first observation is not a restart, it is just the first look.
        [ "$last_mainpid" -ne 0 ] && cog_changed=1
        last_mainpid=$_pid
    fi
    return 0
}

last_restart=0
restart_cog() {
    _why=$1
    if [ $((now_epoch - last_restart)) -lt "$KIOSK_RESTART_BACKOFF" ]; then
        dbg "not restarting $KIOSK_UNIT ($_why): within backoff"
        return 1
    fi
    # If an operator stopped the unit by hand to look at something, do not
    # fight them. "failed" is still ours to fix - that is systemd giving up.
    _state=$(systemctl is-active "$KIOSK_UNIT" 2>/dev/null) || true
    case "$_state" in
        active|activating|failed) ;;
        *) log "$KIOSK_UNIT is '$_state'; leaving it alone"; return 1 ;;
    esac
    last_restart=$now_epoch
    log "restarting $KIOSK_UNIT: $_why"
    # --no-block: a synchronous restart would wedge this loop for the whole job
    # timeout if the unit failed to come up.
    systemctl restart --no-block "$KIOSK_UNIT" >/dev/null 2>&1 ||
        log "systemctl restart $KIOSK_UNIT failed"
    ping_fails=0
    # Whatever is on screen now, we no longer know what it is.
    nav_state=unknown
    return 0
}

# --------------------------------------------------------------------------
# Probing
# --------------------------------------------------------------------------

probe_url=""
probe_mode=http     # http | none

probe_setup() {
    probe_url=${KIOSK_PROBE_URL:-$KIOSK_URL}

    if ! command -v curl >/dev/null 2>&1; then
        # Do not silently fall back to busybox wget: it exits 1 for every kind
        # of failure, so every diagnosis would be "unknown". A missing curl is
        # an image bug, and this line is how it gets noticed.
        probe_mode=none
        log "curl is not installed; running refresh-only, no offline page"
        return
    fi

    case "$probe_url" in
        http://*|https://*) probe_mode=http ;;
        *)
            # file://, data:, or our own tessaro: scheme. There is nothing
            # meaningful to probe, and inventing a failure would put a lie on a
            # public screen. Point KIOSK_PROBE_URL at whatever backend the local
            # page depends on to get probing back.
            probe_mode=none
            log "'$probe_url' is not an http(s) URL; running refresh-only"
            ;;
    esac
}

probe_rc=0
probe_http=""
probe_reason=""

do_probe() {
    probe_http=$(curl --silent --output /dev/null --fail --location \
        --connect-timeout "$KIOSK_PROBE_CONNECT_TIMEOUT" \
        --max-time "$KIOSK_PROBE_TIMEOUT" \
        --retry 0 --user-agent 'tessaro-kiosk-watchdog' \
        --write-out '%{http_code}' "$probe_url" 2>/dev/null)
    probe_rc=$?
    return "$probe_rc"
}

# Turn curl's exit code into something a human reading the journal can act on.
# Nothing from here reaches the screen - diagnostics are journal-only by design.
classify() {
    case "$1" in
        3)  probe_reason="the URL is not valid" ;;
        5)  probe_reason="the configured proxy cannot be resolved" ;;
        6)  probe_reason="DNS did not resolve the host" ;;
        7)  probe_reason="connection refused or network unreachable" ;;
        22) probe_reason="server answered HTTP $probe_http" ;;
        28) probe_reason="timed out after ${KIOSK_PROBE_TIMEOUT}s" ;;
        35) probe_reason="TLS handshake failed" ;;
        47) probe_reason="redirect loop" ;;
        52) probe_reason="server sent an empty reply" ;;
        55|56) probe_reason="connection dropped during transfer" ;;
        60|77) probe_reason="certificate verification failed - check the device clock and the CA store" ;;
        *)  probe_reason="curl exit $1" ;;
    esac
}

# --------------------------------------------------------------------------
# The offline page
#
# Resolved on every use rather than once at startup, so dropping a file onto
# /data takes effect without restarting anything.
# --------------------------------------------------------------------------

offline_source() {
    _size=0
    if [ -r "$KIOSK_OFFLINE_PAGE" ]; then
        _size=$(stat -c %s "$KIOSK_OFFLINE_PAGE" 2>/dev/null) || _size=0
        case "$_size" in ''|*[!0-9]*) _size=0 ;; esac
        if [ "$_size" -gt 0 ] && [ "$_size" -le "$KIOSK_OFFLINE_MAX_BYTES" ]; then
            printf '%s' "$KIOSK_OFFLINE_PAGE"
            return 0
        fi
        log "ignoring $KIOSK_OFFLINE_PAGE (size $_size, limit $KIOSK_OFFLINE_MAX_BYTES)"
    fi
    printf '%s' "$KIOSK_OFFLINE_PAGE_DEFAULT"
}

# Staged through a temporary file and renamed, because rename is atomic on
# tmpfs: cog can never be served a half-written page, and a failed copy leaves
# the previous good one in place.
stage_offline_page() {
    _src=$(offline_source)
    [ -r "$_src" ] || { log "no readable offline page ($_src)"; return 1; }
    mkdir -p "$KIOSK_OFFLINE_DIR" 2>/dev/null ||
        { log "cannot create $KIOSK_OFFLINE_DIR"; return 1; }
    _tmp="$KIOSK_OFFLINE_DIR/.index.html.$$"
    if cp "$_src" "$_tmp" 2>/dev/null &&
       chmod 0644 "$_tmp" 2>/dev/null &&
       mv -f "$_tmp" "$KIOSK_OFFLINE_DIR/index.html" 2>/dev/null; then
        return 0
    fi
    rm -f "$_tmp" 2>/dev/null
    log "staging $_src failed; keeping the previous page"
    return 1
}

# --------------------------------------------------------------------------
# Navigation
# --------------------------------------------------------------------------

nav_state=unknown   # unknown | live | offline
last_nav=0

go_live() {
    if cog_open "$KIOSK_URL"; then
        nav_state=live
        last_nav=$now_epoch
        dbg "navigated to $KIOSK_URL"
    else
        ping_fails=$((ping_fails + 1))
        log "could not tell cog to open the kiosk URL"
    fi
}

go_offline() {
    if [ "$KIOSK_OFFLINE_URL" = "none" ]; then
        return 0
    fi

    if [ -n "$KIOSK_OFFLINE_URL" ]; then
        _uri=$KIOSK_OFFLINE_URL
    else
        stage_offline_page || return 1
        # The query string is cache-busting only; cog's directory handler
        # resolves the path and ignores the query.
        _uri="${OFFLINE_URI}?t=${now_epoch}"
    fi

    if cog_open "$_uri"; then
        nav_state=offline
        last_nav=$now_epoch
        dbg "navigated to the offline page"
    else
        ping_fails=$((ping_fails + 1))
        log "could not tell cog to open the offline page"
    fi
}

# --------------------------------------------------------------------------
# Main loop
# --------------------------------------------------------------------------

fails=0
ping_fails=0
restart_done=0      # at most one streak-triggered restart per outage
now_epoch=0

cycle() {
    now_epoch=$(now)

    # Liveness first, so navigation failures below are attributed correctly.
    if cog_alive; then
        ping_fails=0
    else
        ping_fails=$((ping_fails + 1))
        [ "$ping_fails" -eq 1 ] && log "cog is not answering on the system bus"
    fi

    # A browser that restarted under us is showing whatever its ExecStart URL
    # produced, which we cannot query, so stop claiming to know.
    check_cog_pid
    if [ "$cog_changed" -eq 1 ]; then
        log "cog restarted (pid $last_mainpid); will re-navigate"
        nav_state=unknown
    fi

    if [ "$probe_mode" = "http" ]; then
        if do_probe; then _ok=1; else _ok=0; classify "$probe_rc"; fi
    else
        # Nothing to probe, so assert nothing about the network and never show
        # a made-up failure. The refresh timer and the un-wedging below still
        # run, which is most of the value.
        _ok=1
    fi

    if [ "$_ok" -eq 1 ]; then
        if [ "$fails" -gt 0 ]; then
            log "$probe_url reachable again after $fails failed probes"
            fails=0
            restart_done=0
        fi

        # Navigate on recovery, or when the refresh timer expires - never on
        # every probe. "unknown" counts as a reason to navigate: after a cog
        # restart it may be sitting on its own un-dismissable error page, and
        # we have no way to ask.
        if [ "$nav_state" != "live" ] ||
           { [ "$KIOSK_REFRESH_INTERVAL" -gt 0 ] &&
             [ $((now_epoch - last_nav)) -ge "$KIOSK_REFRESH_INTERVAL" ]; }; then
            go_live
        fi
    else
        fails=$((fails + 1))
        if [ "$fails" -eq "$KIOSK_FAIL_THRESHOLD" ]; then
            log "$probe_url unreachable: $probe_reason"
        fi

        if [ "$fails" -ge "$KIOSK_FAIL_THRESHOLD" ]; then
            if [ "$nav_state" != "offline" ] ||
               { [ "$KIOSK_OFFLINE_REFRESH" -gt 0 ] &&
                 [ $((now_epoch - last_nav)) -ge "$KIOSK_OFFLINE_REFRESH" ]; }; then
                go_offline
            fi
        fi

        # Escalation, second trigger: down long enough that a wedged web process
        # is worth ruling out, and the screen already shows our page so the
        # restart costs nothing visible. Once per outage - restarting against a
        # dead network helps nobody.
        if [ "$restart_done" -eq 0 ] && [ "$KIOSK_RESTART_AFTER" -gt 0 ] &&
           [ "$fails" -ge "$KIOSK_RESTART_AFTER" ]; then
            restart_cog "no successful probe in $fails attempts" && restart_done=1
        fi
    fi

    # Escalation, first trigger: cog itself stopped answering. Independent of
    # the probe, because this one is about the browser and not the network.
    if [ "$ping_fails" -ge "$KIOSK_PING_FAILS" ]; then
        restart_cog "no D-Bus reply after $ping_fails attempts"
    fi
}

main() {
    if [ -z "$KIOSK_URL" ]; then
        log "KIOSK_URL is empty; nothing to watch"
        exit 1
    fi

    if [ "$KIOSK_WATCHDOG_ENABLE" != "1" ]; then
        # Parked rather than masked, so the unit still shows as running and the
        # reason is in the journal. Useful while debugging a page, where the
        # periodic refresh would otherwise keep stealing the view.
        log "KIOSK_WATCHDOG_ENABLE=$KIOSK_WATCHDOG_ENABLE; idling"
        while [ "$running" -eq 1 ]; do nap 60; done
        exit 0
    fi

    probe_setup

    # Stage a page immediately, so /run holds something valid within a second of
    # boot even if this process dies straight afterwards.
    [ "$probe_mode" = "http" ] && stage_offline_page

    log "watching $KIOSK_URL (probe $probe_mode every ${KIOSK_PROBE_INTERVAL}s, refresh every ${KIOSK_REFRESH_INTERVAL}s)"

    while [ "$running" -eq 1 ]; do
        cycle
        if [ "$fails" -gt 0 ]; then
            nap "$KIOSK_PROBE_INTERVAL_FAIL"
        else
            nap "$KIOSK_PROBE_INTERVAL"
        fi
    done

    log "stopping"
}

main "$@"
