#!/bin/sh
#
# First-boot loader for the watchdog container image. Idempotent: podman's
# storage survives on /data, so the image only needs loading once, and a
# device with no network never has to pull anything.
set -eu

# The archive is produced by `mise run watchdog-image` from a docker build
# tagged freevision.sk/tessaro-kiosk-watchdog:latest, and podman load keeps
# the archive's own name. freevision.sk is a namespace, not a registry we
# pull from: the run unit uses --pull=never. The run unit references the
# same name.
IMAGE=freevision.sk/tessaro-kiosk-watchdog:latest
ARCHIVE=/usr/share/tessaro-kiosk/tessaro-kiosk-watchdog-image.tar.gz

if podman image exists "$IMAGE"; then
    exit 0
fi

gunzip -c "$ARCHIVE" | podman load
