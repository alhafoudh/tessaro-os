[Unit]
Description=Tessaro kiosk browser (Chromium on Weston)

# After= alone is ordering only, so Requires= is what stops the kiosk starting
# into a world with no Wayland socket, and PartOf= takes it down and back up
# with Weston. weston.service is Type=notify and only reaches "active" once the
# compositor is really up, which is what makes this a real guarantee.
Requires=weston.service
After=weston.service
PartOf=weston.service

# /run/wayland-0 is created by the socket unit, before Weston itself runs.
# weston.service Requires= it but does not order against it, so we do.
Requires=weston.socket
After=weston.socket

# /run/tessaro-kiosk and /data/kiosk come from
# /usr/lib/tmpfiles.d/tessaro-kiosk.conf: the staged offline page root and the
# Chromium profile directory. Default dependencies already imply this ordering
# via basic.target -> sysinit.target; spelled out so it survives someone
# turning default dependencies off.
After=systemd-tmpfiles-setup.service
After=dbus.socket

# generated.env and the Chromium policy are rendered by this oneshot. Wants=,
# not Requires=: if it failed, the image defaults are still a working kiosk.
Wants=tessaro-config.service
After=tessaro-config.service

# The default kiosk URL is served by nginx on the loopback, and nginx.service
# is Type=forking with an ExecStartPre config test, so After= here means the
# socket is actually accepting by the time Chromium asks for the page.
#
# Ordering only, no Wants=: nginx is enabled by its own preset, and an image
# built without it - one whose KIOSK_URL is a remote site - should not have
# this unit mention a dependency that does not exist. systemd ignores an
# After= on an absent unit silently, which is exactly the behaviour wanted.
#
# Nothing breaks if it is slow anyway. tessaro-agent probes the URL and
# navigates when it answers, so a browser that started too early is corrected
# within one probe interval rather than left on an error page.
After=nginx.service

# Sound goes through PipeWire's Pulse server (tessaro-audio). Ordered after
# it so a page that plays at once finds the socket; Wants= and not Requires=,
# so a sound server that failed never takes the screen with it - the page
# just plays nothing.
Wants=tessaro-pipewire-pulse.service
After=tessaro-pipewire-pulse.service

# Deliberately NOT Wants/After=network-online.target, which the old
# wpe-simple-launcher unit had. That target pulls in whatever wait-online
# implementation the image has - NetworkManager-wait-online.service here - and
# holds the screen black for its timeout on a device with no link. The whole
# point of tessaro-agent and the offline page is that the kiosk lights up
# regardless of the network.

# No start limit. A kiosk that has permanently given up is worse than one that
# retries and logs. The journal is where you find out why.
StartLimitIntervalSec=0

[Service]
Type=exec

# Build-time defaults live under /usr/lib, outside the /etc overlay, so image
# updates can still move them. generated.env is read second and therefore
# wins: it is what tessaro-agent renders from /data/tessaro/tessaro.db - only
# the keys set on this device - and it is written by tessaro-config.service,
# which runs before this unit on every boot. Change it with tessaro-ctl, never
# by hand. The "-" makes a missing file (a render that failed) mean "image
# defaults", not "no browser".
EnvironmentFile=/usr/lib/tessaro-kiosk/tessaro-kiosk.env
EnvironmentFile=-/run/tessaro-kiosk/generated.env

User=weston
Group=weston
# Those before dialout are redundant - systemd already grants the groups the
# weston user holds in /etc/group - but named as documentation: "wayland" is
# what makes /run/wayland-0 (0775, group wayland) reachable, and video/render
# are what let the GPU process open /dev/dri.
#
# dialout and plugdev are not redundant: the weston user is in neither, and
# this is what grants them. They are what the device APIs need, because
# Chromium's device service runs in-process in the browser and opens the node
# itself - there is no privileged helper outside ChromeOS.
#   dialout - /dev/ttyUSB*, /dev/ttyACM* for Web Serial. systemd's
#     50-udev-default.rules already puts them in this group at 0660.
#   plugdev - /dev/hidraw* for WebHID and /dev/bus/usb/* for WebUSB, both of
#     which need 70-tessaro-devices.rules from this recipe to get there;
#     hidraw has no group at all by default and usbfs is 0664 root:root.
SupplementaryGroups=video input render wayland dialout plugdev

# An absolute path, so finding the compositor needs no XDG_RUNTIME_DIR. Same
# value /etc/profile.d/weston-socket.sh exports for interactive logins.
Environment=WAYLAND_DISPLAY=/run/wayland-0

# XDG_RUNTIME_DIR is still required: Wayland clients put their compositor
# connection bookkeeping there, and Chromium puts its IPC sockets there. This
# unit gets no PAM session, so there is no logind-provided /run/user/<uid>;
# systemd makes the directory instead, 0700 and owned by User=, and wipes it
# on stop.
RuntimeDirectory=tessaro-kiosk-xdg
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/tessaro-kiosk-xdg

# /home is a bind of /data/overlay-home (the volatile-binds bbappend in this
# layer), so this is the persistent partition. A systemd unit runs no shell
# profile; HOME still matters for the crashpad database and various dotfiles.
Environment=HOME=/home/weston
WorkingDirectory=/home/weston

# Where Chromium's libpulse finds the sound server: pipewire-pulse, running
# as this same user with its socket in its own runtime directory, not in
# XDG_RUNTIME_DIR above (systemd wipes that one whenever the browser stops).
# Chromium plays through this and nothing else: it is not in the audio group,
# so it cannot open a card itself and fight PipeWire for it.
Environment=PULSE_SERVER=unix:/run/tessaro-audio/pulse/native

# /usr/bin/chromium is the chromium-wrapper the recipe installs. It prepends
# CHROMIUM_EXTRA_ARGS, which tessaro.conf pins to exactly
#
#     --kiosk --no-first-run --ozone-platform=wayland
#
# Do not repeat any of those here. Note in particular that --incognito
# is no longer among them: tessaro.conf overrides CHROMIUM_EXTRA_ARGS to drop
# it, because it threw away cookies, localStorage and service worker caches on
# every restart. Read the comment there before touching either end.
#
# --hide-crash-restore-bubble is load-bearing *because* incognito is gone.
#   With a persistent profile plus Restart=always and field power cuts,
#   Chromium would otherwise put a "Restore pages?" bubble on a public screen.
# --remote-debugging-port=9222 is the agent's health channel. There is no
#   --remote-debugging-address to go with it - that switch exists only in
#   content_shell. The chrome binary hardcodes the loopback bind (127.0.0.1,
#   falling back to ::1) in remote_debugging_server.cc, so CDP is on the
#   loopback structurally and nothing here can widen it.
# --user-data-dir points at the persistent partition and must stay non-default:
#   recent Chromium refuses to open the DevTools port with the default profile.
# --disk-cache-size caps the HTTP cache at 200MB. Also a consequence of losing
#   incognito: the profile now grows, and /data is not large.
# --disable-dev-shm-usage stops Chromium using /dev/shm for shared memory; on
#   the Pi half the RAM goes to /dev/shm, which is not enough.
# --disable-breakpad turns the crash reporter off. Note this is *not*
#   --disable-crash-reporter, which used to be here and did nothing at all:
#   that switch is defined only in chromecast and headless, never in the chrome
#   binary, so it was silently ignored every start.
# --password-store=basic keeps Chromium off the keyring. It has a private
#   session bus (see dbus-run-session below) but no secret service on it.
# --disable-background-networking turns off the component updater and
#   variations fetches: pointless on a kiosk, and recurring outbound requests
#   on a connection that may be metered. It does not silence the one GCM
#   registration line at startup, which is harmless and left alone.
# --autoplay-policy=no-user-gesture-required lets the kiosk page autoplay
#   video with sound - nobody is there to click first.
# --use-angle=gles-egl runs ANGLE, which Chromium draws everything through, on
#   the driver's EGL and GLES instead of its default desktop OpenGL backend.
#   Every target here is a GLES driver first (the Pi 3's VideoCore IV offers
#   desktop GL 2.1 at most), and the hardware video decoders hand their frames
#   over as EGL images. It is meta-chromium's own default for the use-egl
#   PACKAGECONFIG, lost with the rest of CHROMIUM_EXTRA_ARGS when tessaro.conf
#   replaces it. The last --use-angle wins, so KIOSK_CHROMIUM_ARGS_EXTRA can
#   counter it.
# --touch-events tells Chromium whether to expose ontouchstart and
#   navigator.maxTouchPoints to the page. Its default on Linux is *disabled*,
#   not auto, so a real touch panel is invisible to feature detection without
#   this; "auto" ties it to Weston's wl_seat touch capability. Finger input
#   arrives as synthesized mouse events either way. KIOSK_TOUCH.
# --enable-wayland-ime with --wayland-text-input-version=1 is what makes an
#   on-screen keyboard possible at all. Chromium 147 speaks both text-input-v1
#   and text-input-v3 and kWaylandTextInputV3 is FEATURE_ENABLED_BY_DEFAULT, so
#   left alone it binds v3, finds no zwp_text_input_manager_v3 on Weston 13
#   (which implements v1 and input-method-v1, nothing newer) and logs
#   "text-input-v3 not available". Even where v3 exists it would not help:
#   wayland_input_method_context.cc says outright that v3 "does not support
#   input panel show/hide yet", so v1 is the only version that can raise a
#   keyboard. The version switch is read only when --enable-wayland-ime is also
#   present.
#   Both are unconditional on purpose. Whether a keyboard actually appears is
#   decided on the compositor side, by tessaro-weston-config writing
#   [input-method] into the generated weston.ini - see KIOSK_OSK. Deciding it
#   here instead would switch the entire IME path on and off with the panel, so
#   the device would take text input differently depending on what was plugged
#   in; this way only the panel changes. With no input method client bound,
#   weston's input_method_context_create() returns early, no panel surface
#   exists and show_input_panel reaches nothing.
#   These switches are the exception to the counterable-from-EXTRA rule below:
#   --disable-wayland-ime cannot undo them, because IsImeEnabled() tests for
#   --enable-wayland-ime first and returns true. KIOSK_OSK is the lever.
# --enable-features is the single place base::Features are named, because
#   duplicate occurrences of that switch do not merge - the last one wins - so
#   routing them through one variable is what stops KIOSK_CHROMIUM_ARGS_EXTRA
#   silently dropping whatever the default set. Empty is inert.
#   KIOSK_ENABLE_FEATURES; Web Bluetooth is the reason it exists.
# --disable-features is the same switch in the other direction, with the same
#   no-merge rule, hence the same one-variable treatment.
#   KIOSK_DISABLE_FEATURES ships non-empty: it carries
#   FallbackToSWIfGLES3NotSupported, which is what stops the GPU process
#   refusing an ES 2.0 context and dropping the whole browser to software
#   rendering on the Raspberry Pi 3, and PersistentHistograms, which stops
#   every browser start leaving a metrics file on /data. The reasoning is in
#   the env file, next to the value.
# $KIOSK_FPS_ARGS is --show-fps-counter or nothing, rendered by tessaro-agent
#   from browser.fps_counter: systemd cannot make a flag conditional on a
#   0/1, so the agent turns the setting into the switch. Unbraced, so empty
#   is no argument at all.
# $KIOSK_PRINT_ARGS is --kiosk-printing or nothing, rendered the same way from
#   printer.enable: window.print() goes to the CUPS default printer without
#   the print preview dialog (docs/printing.md). Before the extra flags, so
#   an operator's flag can follow it.
# $KIOSK_EXTENSION_ARGS is --load-extension= with the frame unlock extension
#   (its writable copy in /run/tessaro-kiosk/frame-unlock, see
#   tmpfiles-tessaro-kiosk.conf), which lets the player page show
#   sites that forbid framing. Unbraced, so emptying it in the env file or
#   generated.env loads no extension and passes no flag at all.
# $KIOSK_CHROMIUM_ARGS_EXTRA is deliberately *unbraced*. systemd splits $VAR at
#   whitespace and passes ${VAR} as one argument, so this is what lets an
#   operator add several flags (`tessaro-ctl config set browser.args_extra=...`).
#   Empty expands to no arguments at all. Anything put in the fixed set above has to be
#   counterable from here - which is why --disable-pinch is not in it, since
#   Chromium 147 has no --enable-pinch to undo it with.
# ${KIOSK_URL} is braced for the opposite reason: it is one argument even if
#   someone puts a space in it, and it never touches a shell.
#
# dbus-run-session gives Chromium a private session bus for the lifetime of the
# browser, and is the fix for the burst of
#
#   ERROR:dbus/bus.cc  Failed to connect to the bus: Could not parse server
#                      address: Unknown address type
#   ERROR:dbus/object_proxy.cc  Failed to call method:
#                      org.freedesktop.DBus.NameHasOwner
#
# at every start. The cause is not a missing flag: DBUS_SESSION_BUS_ADDRESS is
# simply unset here, so libdbus falls back to *autolaunch*, which needs X11 and
# cannot work on this image - hence "unknown address type" rather than a plain
# connection failure. Silencing it with browser flags does not work either,
# because Chromium probes that bus for several unrelated services; giving it a
# real one is what stops all of them. Measured: 18 error lines per start, down
# to 0.
#
# dbus-run-session execs the browser and exits when it exits, so Restart= still
# behaves. It does become the unit's MainPID, which tessaro-agent reads to
# notice a browser restart - that still works, since what it compares is the
# unit's main pid changing, not which binary it belongs to.
#
# It is only the *session* bus. Web Bluetooth talks to org.bluez on the
# *system* bus (chrome_browser_main_linux.cc initialises BluezDBusManager from
# the shared system bus), which this does not touch and which BlueZ's shipped
# policy already opens to any user.
#
# browser.zoom goes into the profile's Preferences before every start, as the
# weston user so the file keeps its owner: it is Chromium's own Ctrl+/- zoom,
# which the DevTools protocol cannot set and Chromium reads only at start
# (docs/kiosk-browser.md, Page zoom). "-": a zoom never blocks the browser.
ExecStartPre=-/usr/bin/tessaro-agent zoom
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/chromium \
    --hide-crash-restore-bubble \
    --remote-debugging-port=9222 \
    --user-data-dir=/data/kiosk/chromium \
    --disk-cache-size=209715200 \
    --disable-dev-shm-usage \
    --disable-breakpad \
    --password-store=basic \
    --disable-background-networking \
    --autoplay-policy=no-user-gesture-required \
    --use-angle=gles-egl \
    --touch-events=${KIOSK_TOUCH} \
    --enable-wayland-ime \
    --wayland-text-input-version=1 \
    --enable-features=${KIOSK_ENABLE_FEATURES} \
    --disable-features=${KIOSK_DISABLE_FEATURES} \
    $KIOSK_FPS_ARGS \
    $KIOSK_PRINT_ARGS \
    $KIOSK_EXTENSION_ARGS \
    $KIOSK_CHROMIUM_ARGS_EXTRA \
    ${KIOSK_URL}

# Restart=always, not on-failure: Chromium exits 0 on some user paths and a
# kiosk that has stopped over an exit code is worse than one that retries.
Restart=always
RestartSec=5

# SIGTERM makes Chromium shut down cleanly; give it room to tear the renderers
# down before SIGKILL.
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tessaro-kiosk

[Install]
# Weston is WantedBy=graphical.target, and rootfs-postcommands sets
# SYSTEMD_DEFAULT_TARGET=graphical.target because IMAGE_FEATURES has weston.
WantedBy=graphical.target
