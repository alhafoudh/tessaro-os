# Tessaro kiosk build-time defaults.
#
# Do not edit this file on a device. It lives in /usr/lib, outside the /etc
# overlay, so that a later image can still move the defaults. A device changes
# a setting with tessaro-ctl:
#
#     tessaro-ctl config keys                      every setting, what it applies to
#     tessaro-ctl config set browser.url=https://... one or more KEY=VALUE
#     tessaro-ctl config unset browser.url           back to the value in this file
#
# which stores it in /data/tessaro/tessaro.db. tessaro-agent renders what was
# set into /run/tessaro-kiosk/generated.env, and every unit that reads this
# file reads that one second, so a setting always wins over the default here.
# The KIOSK_* names below are the env names of the keys `tessaro-ctl config keys`
# lists.
#
# Read by systemd as an EnvironmentFile=: plain NAME=value, no exports, no
# command substitution.
KIOSK_URL=@kiosk-url@

# Maintenance mode (`tessaro-ctl browser maintenance on|off`). While it is on, the
# screen shows KIOSK_MAINTENANCE_URL instead of KIOSK_URL, which is kept as it
# is; the device-API grants stay with KIOSK_URL's origin. The shipped page is
# served by the self-test's nginx and takes ?title= and ?message=.
KIOSK_MAINTENANCE=0
KIOSK_MAINTENANCE_URL=@maintenance-url@

# The page bridge (docs/bridge.md). KIOSK_INJECT_SCRIPT is a file in
# /data/files, from its root, run in every page before the page's own
# scripts; empty runs none. KIOSK_BRIDGE_MODE is what the page gets as
# window.tessaro: off, config (the settings) or actions (settings and device
# actions).
KIOSK_INJECT_SCRIPT=
KIOSK_BRIDGE_MODE=off

# Chromium's DevTools protocol endpoint, on the loopback the browser binds to.
KIOSK_CDP_URL=http://127.0.0.1:9222

# --- the browser ------------------------------------------------------------
#
# Read by tessaro-kiosk.service only; a change restarts the browser. They are
# here rather than in the unit so a device can be retuned without a new image.

# Extra Chromium flags, appended after the fixed set the unit defines.
# Split at whitespace by systemd, so several flags on one line work. It can
# only add, never remove a flag the unit already passes.
KIOSK_CHROMIUM_ARGS_EXTRA=

# Touch event feature detection: auto | enabled | disabled.
# Chromium's default on Linux is "disabled", which hides a real panel from
# ontouchstart and navigator.maxTouchPoints; "auto" ties it to Weston's
# wl_seat touch capability. Finger input works either way.
#
# Do not leave this empty. Chromium reads an empty --touch-events= as
# *enabled*, not as auto or as its own default, so blanking it is the one
# value that does something surprising.
KIOSK_TOUCH=auto

# Chromium base::Feature names, comma separated, passed as --enable-features.
# Every feature goes here: duplicate --enable-features switches do not merge,
# the last one wins, so a second one in KIOSK_CHROMIUM_ARGS_EXTRA would
# silently discard this. Empty is inert.
#
# The default turns on hardware video decode, and it is the set meta-chromium
# itself selects for its use-v4l2 PACKAGECONFIG (chromium-gn.inc,
# CHROMIUM_EXTRA_ARGS). tessaro.conf replaces CHROMIUM_EXTRA_ARGS to keep
# --incognito out of the wrapper, which drops these with it, so they live here.
# AcceleratedVideoDecodeLinuxGL is what lets Chromium on Linux use a hardware
# decoder at all - V4L2 on the Raspberry Pi, VA-API on x86 - and the ZeroCopy
# one hands the decoded frames to the GPU without a copy through the CPU.
# Setting browser.enable_features replaces this list, so keep these in it.
KIOSK_ENABLE_FEATURES=AcceleratedVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL

# The same, passed as --disable-features. Same merge rule, same reason for
# being one variable.
#
# FallbackToSWIfGLES3NotSupported is not a tuning knob, it is what makes the
# Raspberry Pi 3 usable at all. Chromium asks EGL for an ES 3.0 context, and
# when the driver cannot give it one this feature - FEATURE_ENABLED_BY_DEFAULT
# everywhere except Windows, ui/gl/gl_features.cc - makes the GPU process give
# up and fall back to software rendering rather than take the ES 2.0 context it
# was offered. The Pi 3's VideoCore IV is ES 2.0 only, so the GPU process died
# three times at every boot ("Exiting GPU process due to errors during
# initialization") and the whole page was rasterized on four Cortex-A53s.
# Turning the feature off takes the ES2 path instead: the GPU process comes up,
# holds /dev/dri/renderD128, and resident memory drops by about 500MB on a
# board that has 927MB and no swap.
#
# Harmless on hardware that does support ES 3.0 - the ES3 context succeeds and
# the fallback never runs - so this is set for every machine rather than per
# board. "eglCreateContext ES 3.0 failed" stays in the journal either way; with
# the feature off it is followed by a working ES2 context instead of by the GPU
# process exiting.
KIOSK_DISABLE_FEATURES=FallbackToSWIfGLES3NotSupported

# Chromium's FPS counter in the corner of the screen: 1 or 0
# (browser.fps_counter). The unit cannot make a switch conditional, so the
# agent renders KIOSK_FPS_ARGS=--show-fps-counter from it; the default below
# is no argument at all.
KIOSK_FPS_COUNTER=0
KIOSK_FPS_ARGS=

# Whether the page may print: 1 or 0 (printer.enable). The agent renders
# KIOSK_PRINT_ARGS=--kiosk-printing from it, and PrintingEnabled in the policy;
# the default below is no argument at all and printing off (docs/printing.md).
KIOSK_PRINTING=0
KIOSK_PRINT_ARGS=

# Origins granted WebSerial and WebHID in the Chromium policy besides the
# kiosk's own and the self-test page's (browser.device_origins). Space
# separated, scheme://host[:port]. The agent renders the policy from this and
# from KIOSK_URL, so a device pointed at a new site keeps its device grants.
KIOSK_DEVICE_ORIGINS=

# The self-test page's origin, always granted the device APIs. Must match the
# listen line in tessaro-selftest's nginx conf. Not a setting.
KIOSK_SELFTEST_ORIGIN=@selftest-origin@

# --- the display ------------------------------------------------------------
#
# Read by /usr/libexec/tessaro-weston-config before the compositor starts; a
# change restarts Weston, and with it the browser and the agent.

# Output mode for every connected display: preferred, or WIDTHxHEIGHT
# (screen.resolution). `tessaro-ctl screen modes` lists what the displays offer, and
# nothing else is accepted. A change is on probation: it reverts on its own
# unless `tessaro-ctl screen confirm` arrives within 60 seconds, and a reboot before
# that reverts it too - a wrong mode can leave nobody able to see the screen.
KIOSK_RESOLUTION=preferred

# Weston output scale. Empty means auto: 2 on a panel wider than 3400px, 1
# below. "none" writes no scale= and leaves Weston at its own default.
# Integers only - Weston 13 has no fractional scaling, and Chromium
# cannot scale itself on Wayland, so this is the only lever there is.
#
# Read by /usr/libexec/tessaro-weston-config, which generates
# /run/weston/weston.ini before the compositor starts.
KIOSK_SCALE=

# On-screen keyboard: auto | always | never.
#
# auto shows Weston's virtual keyboard only while no hardware keyboard is
# attached, which is the behaviour a touch-only device wants and the one a
# device with a USB keyboard does not. Counted as a keyboard: USB and Bluetooth
# input devices that udev tags ID_INPUT_KEYBOARD - not the i8042 "AT Translated
# Set 2 keyboard" that exists on most x86 boards with nothing plugged in.
#
# The browser is put in IME mode either way (--enable-wayland-ime in
# tessaro-kiosk.service); this decides only whether there is a keyboard to
# show. Evaluated at compositor start, and again by tessaro-agent whenever a
# device is plugged in or out; if the verdict changed, the agent restarts
# Weston, and the browser with it.
KIOSK_OSK=auto

# Remote access: on | off. Default on.
#
# Puts the live panel on a VNC port at 127.0.0.1:5900, so a technician on an
# SSH tunnel sees exactly what is on the screen. The login is the keys
# below.
#
# **View only.** The viewer will happily send clicks and keystrokes and the
# browser will ignore all of them: Weston's screen-share injects remote input
# into a second wl_seat, and Chromium binds only the first one it sees. See
# item 11 in TODO.md - the fix is a small patch to Weston, not a setting.
# The client has to speak VeNCrypt with plain auth, which means TigerVNC or
# Remmina, because Weston's VNC backend requires TLS and offers no other
# security type.
#
# It is not free while it is on: sharing an output takes Weston off hardware
# overlay and cursor planes and reads every damaged region back out of the
# renderer. That is noise next to a static page and a real cost next to
# full-screen video, so "off" is a reasonable answer on a slow device.
#
# Only outputs present when the compositor starts are shared.
KIOSK_VNC=on

# What the viewer has to type. Read by /usr/libexec/tessaro-vnc-auth, which
# PAM runs on every attempt. Static on purpose: an image property, not a
# setting, so tessaro-ctl has no key for it.
#
# This is deliberately not a system account. Weston authenticates VNC clients
# through PAM as the unprivileged user the compositor runs as, and pam_unix
# cannot check any other account's password from there, which would have
# pinned the username to "weston". See the weston bbappend for the whole
# argument.
#
# The password is a constant in the image and identical on every device built
# from it, which is only acceptable because the port is bound to 127.0.0.1 and
# an SSH tunnel is the only way to reach it.
KIOSK_VNC_USER=tessaro
KIOSK_VNC_PASSWORD=tessaro

# --- sound ------------------------------------------------------------------

# Read by tessaro-agent only, which applies them to PipeWire at once
# (tessaro-ctl audio ...); no unit reads them, and changing one restarts
# nothing.
#
# audio.output: auto | hdmi | jack | usb | bluetooth | off, or one output's
# PipeWire name from `tessaro-ctl audio outputs`. auto is the USB or
# Bluetooth output plugged in last, else HDMI with a screen connected, else
# the jack. A kind that is not plugged in plays on auto until it is.
KIOSK_AUDIO_OUTPUT=auto
# audio.volume, percent, on whichever output plays. The cubic scale a desktop
# slider uses: 50 sounds about half as loud as 100.
KIOSK_AUDIO_VOLUME=80
# audio.mute: 1 mutes the output and keeps the volume.
KIOSK_AUDIO_MUTE=0
# audio.input: auto | jack | usb | bluetooth | off, or one input's name, for
# pages that use the microphone. off records silence.
KIOSK_AUDIO_INPUT=auto
# audio.input_volume, percent.
KIOSK_AUDIO_INPUT_VOLUME=100

# --- the clock --------------------------------------------------------------
# Applied by the agent through timedated and timesyncd, not read by any unit;
# see docs/time.md.
# time.timezone: a tz database name from `tessaro-ctl time zones`.
KIOSK_TIMEZONE=UTC
# time.ntp.enable: 0 stops NTP, for a network without any time server.
KIOSK_NTP=1
# time.ntp.servers: comma separated; empty uses DHCP's, else the fallback.
KIOSK_NTP_SERVERS=

# --- the agent --------------------------------------------------------------

# Offline page. Empty means the shipped default at
# /usr/share/tessaro-kiosk/offline.html, unless /data/kiosk/offline.html exists.
KIOSK_OFFLINE_URL=
KIOSK_OFFLINE_PAGE=/data/kiosk/offline.html

# Probe cadence, in seconds.
KIOSK_PROBE_URL=
KIOSK_PROBE_INTERVAL=30
KIOSK_PROBE_INTERVAL_FAIL=10
KIOSK_PROBE_CONNECT_TIMEOUT=5
KIOSK_PROBE_TIMEOUT=10
KIOSK_FAIL_THRESHOLD=2

# Navigation cadence, in seconds. Kept separate from the probe cadence so that
# probing often does not mean reloading the screen often.
KIOSK_REFRESH_INTERVAL=600
KIOSK_OFFLINE_REFRESH=300

# Escalation. 40 failed probes at 10s while down is a little under seven
# minutes; the backoff then stops it restarting more than once per five.
KIOSK_PING_FAILS=3
KIOSK_RESTART_AFTER=40
KIOSK_RESTART_BACKOFF=300

# Bring the browser back when it leaves the kiosk site. Compared by origin, so
# the site's own pages are left alone.
KIOSK_ENFORCE_ORIGIN=1

# Page zoom in percent, 25 to 500 like Chrome's Ctrl+/-, on top of the Weston
# scale. `tessaro-agent zoom` writes it into the Chromium profile before every
# browser start; 100 leaves the page alone.
KIOSK_ZOOM=100

# The DevTools session, in seconds: the whole budget for one command, the
# keepalive ping (two unanswered and the session reconnects), and the ceiling
# on the reconnect backoff - under KIOSK_PROBE_INTERVAL, so a lost session is
# normally back before the next cycle needs it.
KIOSK_CDP_TIMEOUT=5
KIOSK_CDP_PING=10
KIOSK_CDP_RECONNECT_MAX=15

# Send DeviceAccess.enable when the session comes up - the hook for answering
# Web Bluetooth choosers over CDP (TODO item 5). Nothing uses it yet.
KIOSK_DEVICE_ACCESS=0

# 1: ping the systemd watchdog only while the agent is keeping its own
# deadlines. 0: ping regardless.
KIOSK_WATCHDOG=1

KIOSK_AGENT_ENABLE=1

# --- the debug screen -------------------------------------------------------
#
# `tessaro-ctl browser debug on` puts KIOSK_DEBUG_TEMPLATE on screen in large
# monospaced text instead of the site, refreshed every few seconds, with no
# probing and no offline page; `tessaro-ctl browser debug off` brings the site
# back. Not KIOSK_DEBUG, which is the agent's journal verbosity.
KIOSK_DEBUG_SCREEN=0

# What it shows: {key} placeholders exactly as in browser.url - any setting,
# read-only or custom, plus {browser.url} itself, expanded - with values left
# as they are rather than percent-encoded, and \n typed as a line break.
# Single-quoted because systemd keeps a backslash only inside single quotes;
# unquoted, \n would reach the agent as a plain n. {network.public_ip} asks
# Cloudflare only while the screen is up.
KIOSK_DEBUG_TEMPLATE='{device.name}\n\nid     {device.id}\nhost   {network.hostname}\n\nroute  {network.interface} via {network.gateway}\nip     {network.cidr}\nmac    {network.mac}\ndns    {network.dns}\npublic {network.public_ip}\n\nifs    {network.interfaces}\nipv6   {network.ipv6}\n\ndata   {storage.data_free} free of {storage.data_size}\n\nurl    {browser.url}'

# --- the control API --------------------------------------------------------
#
# tessaro-ctl reaches the agent over /run/tessaro-agent.sock on the device
# (root only, no token) and over TLS here from anywhere else. A fresh device
# is unclaimed: over TCP it answers only `id` and `claim`, and the first
# client to claim it gets a token and sets a random root password, shown to
# that client once. `off` turns the TCP side off; the local socket stays.
KIOSK_API_LISTEN=0.0.0.0:7400

# Announce the device as NAME.local and as _tessaro._tcp, so tessaro-ctl can
# find it by name. This tells the whole network segment that a kiosk is here
# and whether it is claimed; `off` where that matters.
KIOSK_MDNS=on

# How long a Webconfig browser session lasts without being used, in
# seconds: a week. Open pages refreshing in the background are not use.
KIOSK_SESSION_TIMEOUT=604800

# The device's network name. Empty derives adjective-noun-xxxx from the node
# id, which is itself derived from /etc/machine-id. The hotspot is named
# tessaro-NAME after it.
KIOSK_NODE_NAME=

# The device's own network: the NetworkManager profiles the agent renders
# from these at every boot and switches between on `tessaro-ctl config set`,
# each change checked by the device before it is saved. Ethernet is DHCP on
# the first port that comes up (auto) unless set static; WiFi is the hotspot
# tessaro-NAME - open until the device is claimed - until `tessaro-ctl network
# wifi join` makes it a client. `tessaro-ctl config keys` documents the
# network.ethernet.* and network.wifi.* keys.
KIOSK_ETHERNET_INTERFACE=auto
KIOSK_ETHERNET_MODE=dhcp
KIOSK_WIFI_INTERFACE=auto
KIOSK_WIFI_MODE=hotspot
# Hotspot clients reach the internet and the LAN through the device; 0 keeps
# them to the device itself.
KIOSK_WIFI_NAT=1
# A phone joining the unclaimed hotspot gets its sign-in sheet with the setup
# portal, until the portal's first saved change turns it off.
KIOSK_WIFI_CAPTIVE=1
KIOSK_WIFI_SECURITY=psk
KIOSK_WIFI_HIDDEN=0
KIOSK_WIFI_IPV4=dhcp
# A client that has not connected this long after boot gives way to the
# hotspot until the next boot, so a device moved away from its network can
# still be reached; 0 never falls back.
KIOSK_WIFI_FALLBACK_AFTER=120

# The MACHINE this image was built for, reported by `tessaro-ctl device id` and in
# the mDNS record. Not a setting.
KIOSK_MACHINE=@machine@

# The kernel's file name on the boot partition, which is what an image update
# (tessaro-ctl update) copies out of the new image and swaps in. It carries
# the bundled initramfs that applies the update. TESSARO_KERNEL_FILE in the
# kas config. Not a setting.
KIOSK_KERNEL_FILE=@kernel-file@

# --- the Raspberry Pi firmware ----------------------------------------------
#
# Where the firmware's config.txt is: /boot on the Raspberry Pi, empty on
# every other machine. The agent writes the firmware's settings there, into
# tessaro.txt, which config.txt includes last, and offers device.gpu_mem only
# where this is set. TESSARO_BOOT_CONFIG_DIR in the kas config. Not a
# setting.
KIOSK_BOOT_CONFIG_DIR=@boot-config-dir@

# Megabytes of RAM the firmware keeps for the GPU (device.gpu_mem), which its
# hardware video decoder draws from; everything else the GPU draws, under full
# KMS, comes from the kernel's CMA pool. Empty writes no gpu_mem= line and
# keeps the firmware's own default. Read at power-on, so a change takes effect
# at the next reboot.
KIOSK_GPU_MEM=
