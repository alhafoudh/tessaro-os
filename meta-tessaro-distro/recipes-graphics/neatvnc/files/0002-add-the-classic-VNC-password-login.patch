From: Ahmed Al Hafoudh <alhafoudh@freevision.sk>
Date: Mon, 05 Oct 2026 14:30:00 +0200
Subject: [PATCH] Add the classic VNC password login (security type 2)

The classic VNC password login, a DES challenge and response, is the one
login nearly every viewer speaks: macOS Screen Sharing, Royal TSX,
RealVNC, noVNC, TightVNC, UltraVNC. neatvnc 0.8.1 does not implement it.
Upstream's 6109e61 ("Add DES authentication (VNC security type 2)", in
1.0.0) does, on top of 1.0's asynchronous auth callback, which 0.8.1 and
Weston 13 do not have. This is the same login on 0.8.1's synchronous code:

- nvnc_set_vnc_password() gives the password (the server needs it in
  plain to check the response). Only its first 8 characters count, as in
  every VNC server; a longer one is logged, as upstream's ca3ce8d does.
- NVNC_AUTH_ALLOW_BROKEN_CRYPTO, upstream's flag, offers the login when
  a login is required and encryption is not. It is listed after Apple DH,
  as upstream lists it.
- An RFB 3.3 client is told this type, when it is offered.
- The DES itself is upstream's crypto_des_rfb_encrypt() (des-rfb.c), on
  nettle's des.h, so it exists only with HAVE_CRYPTO.

Upstream-Status: Backport [https://github.com/any1/neatvnc/commit/6109e61, adapted to the 0.8 auth API]

Signed-off-by: Ahmed Al Hafoudh <alhafoudh@freevision.sk>
---
 include/common.h    |  4 +++
 include/crypto.h    |  6 ++++
 include/neatvnc.h   |  6 ++++
 src/crypto-nettle.c | 30 ++++++++++++++++++
 src/server.c        | 70 +++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 116 insertions(+)

--- a/include/common.h
+++ b/include/common.h
@@ -50,6 +50,7 @@
 	VNC_CLIENT_STATE_WAITING_FOR_VENCRYPT_PLAIN_AUTH,
 #endif
 #ifdef HAVE_CRYPTO
+	VNC_CLIENT_STATE_WAITING_FOR_DES_AUTH_RESPONSE,
 	VNC_CLIENT_STATE_WAITING_FOR_APPLE_DH_RESPONSE,
 	VNC_CLIENT_STATE_WAITING_FOR_RSA_AES_PUBLIC_KEY,
 	VNC_CLIENT_STATE_WAITING_FOR_RSA_AES_CHALLENGE,
@@ -114,6 +115,7 @@
 	bool formats_changed;

 #ifdef HAVE_CRYPTO
+	uint8_t des_challenge[16];
 	struct crypto_key* apple_dh_secret;

 	struct {
@@ -168,6 +170,8 @@
 #ifdef HAVE_CRYPTO
 	struct crypto_rsa_pub_key* rsa_pub;
 	struct crypto_rsa_priv_key* rsa_priv;
+	/* The classic VNC password, at most 8 characters; empty if unset. */
+	char vnc_password[9];
 #endif

 	int n_security_types;
--- a/include/crypto.h
+++ b/include/crypto.h
@@ -111,3 +111,9 @@
 		size_t dst_size, const uint8_t* src, size_t src_size);
 ssize_t crypto_rsa_decrypt(struct crypto_rsa_priv_key* priv, uint8_t* dst,
 		size_t dst_size, const uint8_t* src, size_t src_size);
+
+/* The classic VNC login's response: the 16-byte challenge encrypted with
+ * DES, keyed by the password's first 8 bytes with each byte's bits
+ * reversed. */
+void crypto_des_rfb_encrypt(uint8_t* dst, const uint8_t* src,
+		const char* password);
--- a/include/neatvnc.h
+++ b/include/neatvnc.h
@@ -98,6 +98,9 @@
 enum nvnc_auth_flags {
 	NVNC_AUTH_REQUIRE_AUTH = 1 << 0,
 	NVNC_AUTH_REQUIRE_ENCRYPTION = 1 << 1,
+	/* Also offer the classic VNC password (DES) when no encryption is
+	 * required and nvnc_set_vnc_password() gave one. */
+	NVNC_AUTH_ALLOW_BROKEN_CRYPTO = 1 << 2,
 };

 struct nvnc_log_data {
@@ -167,6 +170,9 @@
 int nvnc_set_tls_creds(struct nvnc* self, const char* privkey_path,
                      const char* cert_path);
 int nvnc_set_rsa_creds(struct nvnc* self, const char* private_key_path);
+/* The password for the classic VNC login. Only its first 8 characters
+ * count. Set it before the first client connects. */
+int nvnc_set_vnc_password(struct nvnc* self, const char* password);

 struct nvnc_fb* nvnc_fb_new(uint16_t width, uint16_t height,
                             uint32_t fourcc_format, uint16_t stride);
--- a/src/crypto-nettle.c
+++ b/src/crypto-nettle.c
@@ -9,6 +9,7 @@
 #include <nettle/aes.h>
 #include <nettle/eax.h>
 #include <nettle/md5.h>
+#include <nettle/des.h>
 #include <nettle/sha1.h>
 #include <nettle/sha.h>
 #include <nettle/rsa.h>
@@ -115,6 +116,35 @@
 	getrandom(dst, len, 0);
 }

+static void des_rfb_reverse_bits(uint8_t* dst, const char* src)
+{
+	for (int i = 0; i < 8; i++) {
+		uint8_t b = (uint8_t)src[i];
+		b = ((b & 0xf0) >> 4) | ((b & 0x0f) << 4);
+		b = ((b & 0xcc) >> 2) | ((b & 0x33) << 2);
+		b = ((b & 0xaa) >> 1) | ((b & 0x55) << 1);
+		dst[i] = b;
+	}
+}
+
+void crypto_des_rfb_encrypt(uint8_t* dst, const uint8_t* src,
+		const char* password)
+{
+	char key[8] = {};
+	size_t len = strlen(password);
+	if (len > 8)
+		len = 8;
+	memcpy(key, password, len);
+
+	uint8_t vnc_key[8];
+	des_rfb_reverse_bits(vnc_key, key);
+
+	struct des_ctx ctx;
+	des_set_key(&ctx, vnc_key);
+	des_encrypt(&ctx, 8, dst, src);
+	des_encrypt(&ctx, 8, dst + 8, src + 8);
+}
+
 static void crypto_import(mpz_t n, const uint8_t* src, size_t len)
 {
 	int order = 1;
--- a/src/server.c
+++ b/src/server.c
@@ -238,6 +238,11 @@

 		if (!(server->auth_flags & NVNC_AUTH_REQUIRE_ENCRYPTION)) {
 			ADD_SECURITY_TYPE(RFB_SECURITY_TYPE_APPLE_DH);
+
+			if ((server->auth_flags & NVNC_AUTH_ALLOW_BROKEN_CRYPTO) &&
+			    server->vnc_password[0]) {
+				ADD_SECURITY_TYPE(RFB_SECURITY_TYPE_VNC_AUTH);
+			}
 		}
 #endif
 	} else {
@@ -303,10 +308,31 @@
 	return 12;
 }

+#ifdef HAVE_CRYPTO
+static int des_auth_send_challenge(struct nvnc_client* client)
+{
+	crypto_random(client->des_challenge, sizeof(client->des_challenge));
+	return stream_write(client->net_stream, client->des_challenge,
+			sizeof(client->des_challenge), NULL, NULL);
+}
+#endif
+
 static int on_version_message_rfb33(struct nvnc_client* client)
 {
 	struct nvnc* server = client->server;

+#ifdef HAVE_CRYPTO
+	if ((server->auth_flags & NVNC_AUTH_REQUIRE_AUTH) &&
+	    is_allowed_security_type(server, RFB_SECURITY_TYPE_VNC_AUTH)) {
+		uint32_t sec_type = htonl(RFB_SECURITY_TYPE_VNC_AUTH);
+		stream_write(client->net_stream, &sec_type, sizeof(sec_type),
+				NULL, NULL);
+		des_auth_send_challenge(client);
+		client->state = VNC_CLIENT_STATE_WAITING_FOR_DES_AUTH_RESPONSE;
+		return 12;
+	}
+#endif
+
 	if (server->auth_flags & NVNC_AUTH_REQUIRE_AUTH)
 		return refuse_rfb33(client,
 				"Authentication required, but not supported for RFB 3.3");
@@ -552,6 +578,30 @@
 	return 0;
 }

+static int on_des_auth_response(struct nvnc_client* client)
+{
+	struct nvnc* server = client->server;
+
+	if (client->buffer_len - client->buffer_index <
+			sizeof(client->des_challenge))
+		return 0;
+
+	const uint8_t* response = client->msg_buffer + client->buffer_index;
+
+	uint8_t expected[sizeof(client->des_challenge)];
+	crypto_des_rfb_encrypt(expected, client->des_challenge,
+			server->vnc_password);
+
+	if (memcmp(expected, response, sizeof(expected)) != 0) {
+		security_handshake_failed(client, NULL, "Invalid password");
+		return sizeof(client->des_challenge);
+	}
+
+	security_handshake_ok(client, NULL);
+	client->state = VNC_CLIENT_STATE_WAITING_FOR_INIT;
+	return sizeof(client->des_challenge);
+}
+
 static int on_apple_dh_response(struct nvnc_client* client)
 {
 	struct nvnc* server = client->server;
@@ -913,6 +963,10 @@
 		break;
 #endif
 #ifdef HAVE_CRYPTO
+	case RFB_SECURITY_TYPE_VNC_AUTH:
+		des_auth_send_challenge(client);
+		client->state = VNC_CLIENT_STATE_WAITING_FOR_DES_AUTH_RESPONSE;
+		break;
 	case RFB_SECURITY_TYPE_APPLE_DH:
 		apple_dh_send_public_key(client);
 		client->state = VNC_CLIENT_STATE_WAITING_FOR_APPLE_DH_RESPONSE;
@@ -1814,6 +1868,8 @@
 		return on_vencrypt_plain_auth_message(client);
 #endif
 #ifdef HAVE_CRYPTO
+	case VNC_CLIENT_STATE_WAITING_FOR_DES_AUTH_RESPONSE:
+		return on_des_auth_response(client);
 	case VNC_CLIENT_STATE_WAITING_FOR_APPLE_DH_RESPONSE:
 		return on_apple_dh_response(client);
 	case VNC_CLIENT_STATE_WAITING_FOR_RSA_AES_PUBLIC_KEY:
@@ -2656,3 +2712,17 @@
 #endif
 	return -1;
 }
+
+EXPORT
+int nvnc_set_vnc_password(struct nvnc* self, const char* password)
+{
+#ifdef HAVE_CRYPTO
+	if (strlen(password) > 8)
+		nvnc_log(NVNC_LOG_WARNING, "The VNC password is longer than 8 characters; only the first 8 are used");
+
+	memset(self->vnc_password, 0, sizeof(self->vnc_password));
+	strncpy(self->vnc_password, password, sizeof(self->vnc_password) - 1);
+	return 0;
+#endif
+	return -1;
+}
