+/* Note `code` held down, or no longer held. */
+static void
+ss_seat_hold(struct wl_array *held, uint32_t code, bool down)
+{
+	uint32_t *k, *slot;
+
+	wl_array_for_each(k, held) {
+		if (*k != code)
+			continue;
+		if (!down) {
+			*k = *(uint32_t *) ((char *) held->data + held->size -
+					    sizeof *k);
+			held->size -= sizeof *k;
+		}
+		return;
+	}
+
+	if (down) {
+		slot = wl_array_add(held, sizeof *slot);
+		if (slot)
+			*slot = code;
+	}
+}
+
+/* Let go of every key and button the viewer still holds, so that nothing
+ * stays pressed on the shared seat after it disconnects. */
+static void
+ss_seat_release_held(struct ss_seat *seat)
+{
+	struct timespec ts;
+	uint32_t *k;
+
+	weston_compositor_get_time(&ts);
+
+	if (seat->has_keyboard) {
+		wl_array_for_each(k, &seat->keys)
+			notify_key(seat->target, &ts, *k,
+				   WL_KEYBOARD_KEY_STATE_RELEASED,
+				   STATE_UPDATE_AUTOMATIC);
+	}
+	seat->keys.size = 0;
+
+	if (seat->has_pointer) {
+		wl_array_for_each(k, &seat->buttons) {
+			notify_button(seat->target, &ts, *k,
+				      WL_POINTER_BUTTON_STATE_RELEASED);
+			notify_pointer_frame(seat->target);
+		}
+	}
+	seat->buttons.size = 0;
+}
+
+/* Move the target seat's pointer to where the viewer's is. The child's
+ * surface is this output's buffer, so the position is in output pixels; the
+ * seat wants global coordinates, which differ by the output's position,
+ * scale and transform. */
+static void
+ss_seat_move(struct ss_seat *seat, const struct timespec *ts,
+	     wl_fixed_t x, wl_fixed_t y)
+{
+	struct weston_coord_global pos;
+
+	pos = weston_coord_global_from_output_point(wl_fixed_to_double(x),
+						    wl_fixed_to_double(y),
+						    seat->output->output);
+	notify_motion_absolute(seat->target, ts, pos);
+	notify_pointer_frame(seat->target);
+}
+
+/*
+ * Pointer focus is not touched on enter and leave: the target seat's focus
+ * is whatever its cursor is over, local or remote. But enter carries the
+ * viewer's first position - a viewer that moves once and clicks sends no
+ * motion besides it - so the pointer goes there.
+ */
 static void
 ss_seat_handle_pointer_enter(void *data, struct wl_pointer *pointer,
 			     uint32_t serial, struct wl_surface *surface,
 			     wl_fixed_t x, wl_fixed_t y)
 {
 	struct ss_seat *seat = data;
+	struct timespec ts;

-	/* No transformation of input position is required here because we are
-	 * always receiving the input in the same coordinates as the output. */
-
-	clear_pointer_focus(&seat->base);
+	weston_compositor_get_time(&ts);
+	ss_seat_move(seat, &ts, x, y);
 }

