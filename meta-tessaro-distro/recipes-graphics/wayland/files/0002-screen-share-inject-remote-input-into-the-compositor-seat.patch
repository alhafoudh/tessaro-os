+/*
+ * The seat remote input goes into: the compositor's first, the one the
+ * libinput backend made for the local devices and every client has bound.
+ * With no input device at all there is none, and one is made here and kept
+ * until the compositor goes, so that a client that bound it keeps it across
+ * viewers. It is not called "default": the libinput backend looks its seats
+ * up by name and would take this one for its own.
+ */
+static struct weston_seat *
+ss_target_seat(struct screen_share *ss)
+{
+	struct weston_compositor *c = ss->compositor;
+	struct weston_seat *seat;
+
+	if (ss->own_seat)
+		return ss->own_seat;
+
+	if (!wl_list_empty(&c->seat_list))
+		return wl_container_of(c->seat_list.next, seat, link);
+
+	seat = zalloc(sizeof *seat);
+	if (seat == NULL)
+		return NULL;
+	weston_seat_init(seat, c, "screen-share");
+	ss->own_seat = seat;
+
+	return seat;
+}
