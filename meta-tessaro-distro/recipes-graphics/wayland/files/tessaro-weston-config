#!/bin/sh
# Generate Weston's effective config from the hardware actually attached: an
# output scale that suits the panel, an on-screen keyboard only on a device
# that has no keyboard of its own, and the screen share that puts the panel on
# a VNC port for remote support.
#
# Why the scale is here: Chromium cannot scale itself on this stack. It only
# honours --force-device-scale-factor when the compositor advertises
# wp_fractional_scale_manager_v1, and Weston 13 does not implement that
# protocol server side - the XML in its tree is used by its own demo clients.
# Chromium's own source calls the switch "TEST ONLY" on Wayland. So the scale
# has to come from weston.ini, and weston.ini's [output] sections match an
# exact connector name, with no wildcards and no command-line equivalent on the
# DRM backend. Hence: generate it, per boot, from what is plugged in.
#
# Why the keyboard is here: whether the virtual keyboard appears is decided by
# whether Weston has an input method client at all, which is weston.ini's
# [input-method] path=. The browser side of it is unconditional - see the
# --enable-wayland-ime comment in tessaro-kiosk.service. Same argument as the
# scale: a shipped image cannot know whether it will meet a USB keyboard.
#
# Why the screen share is here: it is weston.ini's [screen-share] command=, and
# it is only a section rather than a knob because a VNC backend cannot be added
# to a running compositor - see the block that writes it below.
#
# Run as ExecStartPre= of weston.service (see the drop-in next to this file),
# as User=weston. /sys/class/drm, /sys/class/input and the udev database are
# world readable and $RUNTIME_DIRECTORY is ours, so no privilege is needed.
#
# tessaro-agent also runs it, as root, whenever a screen or keyboard is
# plugged in or out after Weston started: into a scratch file
# (TESSARO_WESTON_CONFIG), which it compares with the config Weston is
# running, and restarts Weston only if they differ. So everything this script
# writes must depend on the settings and the hardware only - no timestamps,
# nothing random - or every hotplug would restart the compositor.
#
# The technician-facing file is still /etc/xdg/weston/weston.ini, which is on
# the /etc overlay and therefore persists. It is used as the base below, and an
# [output] or [input-method] section written there by hand always wins over
# what this computes. /run/weston/weston.ini is generated and must never be
# edited.
#
# POSIX sh, because the image has busybox and nothing else this early.
set -eu

DRM_ROOT="${TESSARO_DRM_ROOT:-/sys/class/drm}"
INPUT_ROOT="${TESSARO_INPUT_ROOT:-/sys/class/input}"
BASE="${TESSARO_WESTON_BASE:-/etc/xdg/weston/weston.ini}"
OUT="${TESSARO_WESTON_CONFIG:-/run/weston/weston.ini}"

DEFAULTS=/usr/lib/tessaro-kiosk/tessaro-kiosk.env
# What was set on this device, rendered by tessaro-agent from
# /data/tessaro/tessaro.db (tessaro-config.service runs before weston.service).
# Change a key with tessaro-ctl, never here.
OVERRIDE="${TESSARO_OVERRIDE:-/run/tessaro-kiosk/generated.env}"

# Where the VNC screen share listens, and the certificate it needs. Loopback
# only: the way in is an SSH tunnel, which is what actually authenticates the
# technician and encrypts the link. The certificate is shipped by the
# weston-init bbappend and is the same on every device built from one image,
# so it proves nothing about which kiosk answered - another reason the port
# does not leave the machine.
VNC_ADDRESS=127.0.0.1
VNC_PORT=5900
VNC_TLS_CERT=/usr/lib/tessaro-vnc/tls.crt
VNC_TLS_KEY=/usr/lib/tessaro-vnc/tls.key
# The classic VNC password for viewers without TLS, written below from the
# image's KIOSK_VNC_PASSWORD. A fixed path, so the generated config is the
# same whoever writes it.
VNC_PASSWORD_FILE=/run/weston/vnc-password

# Read one key out of a systemd environment file.
#
# Deliberately not `.` or `source`: these files legitimately contain values
# like KIOSK_CHROMIUM_ARGS_EXTRA=--foo --bar, which a shell would try to
# execute. sed also means a missing file is just no output. systemd strips
# surrounding quotes and sed does not, so do that here.
read_key() {
    [ -r "$1" ] || return 0
    sed -n "s/^[[:space:]]*$2=//p" "$1" | tail -n 1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}

scale_override=$(read_key "$DEFAULTS" KIOSK_SCALE)
o=$(read_key "$OVERRIDE" KIOSK_SCALE)
[ -n "$o" ] && scale_override=$o

# WIDTHxHEIGHT, or preferred (Weston's own default: the connector's preferred
# mode). tessaro-agent only accepts a mode some connected display advertised,
# and the change reverts unless confirmed; the per-connector check below is
# the last line of defence, for a display that was swapped since.
resolution=$(read_key "$DEFAULTS" KIOSK_RESOLUTION)
o=$(read_key "$OVERRIDE" KIOSK_RESOLUTION)
[ -n "$o" ] && resolution=$o
[ -n "$resolution" ] || resolution=preferred

# Degrees clockwise, or flipped (mirrored) and flipped-N (screen.rotation), as
# Weston's [output] transform=. Weston turns touch input with the output it
# is bound to, so nothing else follows it. On probation like the resolution.
rotation=$(read_key "$DEFAULTS" KIOSK_ROTATION)
o=$(read_key "$OVERRIDE" KIOSK_ROTATION)
[ -n "$o" ] && rotation=$o
[ -n "$rotation" ] || rotation=0

case $rotation in
    0) transform= ;;
    90|180|270) transform=rotate-$rotation ;;
    flipped) transform=flipped ;;
    flipped-90|flipped-180|flipped-270) transform=flipped-rotate-${rotation#flipped-} ;;
    *)
        echo "tessaro-weston-config: KIOSK_ROTATION=$rotation is not 0, 90, 180, 270 or flipped[-N] - using 0" >&2
        transform=
        ;;
esac

osk=$(read_key "$DEFAULTS" KIOSK_OSK)
o=$(read_key "$OVERRIDE" KIOSK_OSK)
[ -n "$o" ] && osk=$o
[ -n "$osk" ] || osk=auto

case $osk in
    auto|always|never) ;;
    *)
        echo "tessaro-weston-config: KIOSK_OSK=$osk is not auto, always or never - using auto" >&2
        osk=auto
        ;;
esac

vnc=$(read_key "$DEFAULTS" KIOSK_VNC)
o=$(read_key "$OVERRIDE" KIOSK_VNC)
[ -n "$o" ] && vnc=$o
[ -n "$vnc" ] || vnc=on

case $vnc in
    on|view-only|off) ;;
    *)
        echo "tessaro-weston-config: KIOSK_VNC=$vnc is not on, view-only or off - using on" >&2
        vnc=on
        ;;
esac

# screen.input.keyboard=0: tessaro-agent's udev rule has libinput ignore
# every keyboard, so none counts as attached below.
keyboard_input=$(read_key "$DEFAULTS" KIOSK_INPUT_KEYBOARD)
o=$(read_key "$OVERRIDE" KIOSK_INPUT_KEYBOARD)
[ -n "$o" ] && keyboard_input=$o

# Is a keyboard someone can actually type on attached right now?
#
# Both filters are needed:
#
#   * udev's ID_INPUT_KEYBOARD, set by systemd's input_id builtin
#     (60-input-id.rules), which is the only thing here that knows a full
#     keyboard from a device that merely has keys. A power button, a lid
#     switch and the consumer-control endpoint of a mouse all carry EV_KEY and
#     none of them are keyboards.
#   * the bus. Nearly every x86 board exposes an "AT Translated Set 2 keyboard"
#     through the i8042 or the embedded controller whether or not anything is
#     plugged into the port, so counting those would mean the keyboard never
#     appeared on x86 at all. USB (0003) and Bluetooth (0005) only.
#
# Under QEMU this comes out as "keyboard attached" and that is correct, not a
# bug in the filter: runqemu boots x86 with `-machine q35,i8042=off -usb
# -device usb-kbd`, so the guest really does have a USB keyboard - it is the
# one the VNC window types on. Testing the panel there means KIOSK_OSK=always.
#
# A barcode scanner the agent reads (`tessaro-ctl scanner`) is no keyboard:
# its udev rule (68-tessaro-scanners.rules) gives it TESSARO_SCANNER, and it
# types nothing anyone sees. One nobody set up, an RFID reader or a KVM dongle
# enumerates as a USB HID keyboard, so on a device with one of those auto
# will decide there is a keyboard. KIOSK_OSK=always is the answer there.
#
# Anything that goes wrong here - no udevadm, an unpopulated udev database -
# ends up reporting no keyboard, which shows the on-screen one. That is the
# safe direction: a superfluous keyboard on a screen is a nuisance, a
# touch-only device with no way to type is a brick.
#
# An ignored keyboard types nothing, so with screen.input.keyboard=0 there is
# none: auto shows the on-screen keyboard, and one plugged in changes nothing
# here, so the hotplug check restarts nothing for it.
hw_keyboard_present() {
    [ "$keyboard_input" = 0 ] && return 1

    for dev in "$INPUT_ROOT"/input*; do
        [ -r "$dev/id/bustype" ] || continue
        case $(cat "$dev/id/bustype") in
            0003|0005) ;;
            *) continue ;;
        esac

        props=$(udevadm info --query=property --path="$dev" 2>/dev/null)
        printf '%s\n' "$props" | grep -q '^ID_INPUT_KEYBOARD=1$' || continue
        printf '%s\n' "$props" | grep -q '^TESSARO_SCANNER=' && continue

        echo "tessaro-weston-config: keyboard attached: $(cat "$dev/name" 2>/dev/null || echo "${dev##*/}")"
        return 0
    done

    return 1
}

mkdir -p "$(dirname "$OUT")"

# Start from the shipped config so Moonforge's [core]/[shell] settings and any
# local edits survive. A missing base is not fatal - Weston has defaults for
# everything in it - but it does mean something is wrong, so say so.
if [ -r "$BASE" ]; then
    cat "$BASE" > "$OUT"
else
    echo "tessaro-weston-config: $BASE is missing, generating from nothing" >&2
    : > "$OUT"
fi

# Start with no screen at all, and keep running. Weston 13's [core]
# require-outputs defaults to "any": with no output it can enable, the
# compositor exits with status 1 and not one line saying why - its log stops
# at "Color manager: no-op". So a device booted with nothing plugged in, which
# under full KMS on the Pi is a real disconnected HDMI-A-1, never ran Weston,
# the browser or anything else on screen, and there was nothing for a screen
# plugged in later to appear on. With "none" Weston comes up headless, lights
# the screen when it is plugged in, and tessaro-agent's hotplug check then
# restarts it onto the proper config. A value set by hand in the base wins.
if grep -q '^[[:space:]]*require-outputs[[:space:]]*=' "$OUT"; then
    :
elif grep -q '^[[:space:]]*\[core\][[:space:]]*$' "$OUT"; then
    sed -i '/^[[:space:]]*\[core\][[:space:]]*$/a require-outputs=none' "$OUT"
else
    printf '\n[core]\nrequire-outputs=none\n' >> "$OUT"
fi

# And keep running with no input device. [core] require-input defaults to
# true, and then libweston's libinput backend refuses to start when it finds
# no device (udev_input_enable, libweston/libinput-seat.c). screen.input.*
# can have libinput ignore every device there is, and a signage board may
# have none plugged in at all. A value set by hand in the base wins.
if grep -q '^[[:space:]]*require-input[[:space:]]*=' "$OUT"; then
    :
else
    sed -i '/^[[:space:]]*\[core\][[:space:]]*$/a require-input=false' "$OUT"
fi

# Which connectors were connected when this ran, as a comment Weston ignores.
# tessaro-agent runs this script again after a hotplug and compares
# (agent/tessaro-agent/src/hotplug.rs): a connector that is connected now but
# is not on this line was plugged in after Weston started, and Weston is
# restarted onto it - even when nothing below would write an [output] for it,
# as on a device booted with no screen at all. Keep the exact prefix; the
# agent matches it.
connected=
for dev in "$DRM_ROOT"/card*-*; do
    [ -r "$dev/status" ] || continue
    [ "$(cat "$dev/status")" = connected ] || continue
    name=${dev##*/}
    case $name in *-Writeback-*) continue ;; esac
    connected="$connected ${name#*-}"
done
printf '\n# tessaro-weston-config: connected%s\n' "${connected:- (none)}" >> "$OUT"

# The on-screen keyboard, before the scale, so that KIOSK_SCALE=none below
# still leaves it configured.
#
# Weston's default for [input-method] path= is its own weston-keyboard, which
# ships in the image, so *enabling* the keyboard means writing nothing at all -
# leaving the default alone is also the only way to avoid hardcoding a
# libexecdir here. Disabling it is an explicit empty path, which text-backend.c
# tests for and treats as "launch nothing".
#
# With no input method client running, weston's input_method_context_create()
# returns early and the panel never exists, so Chromium's show_input_panel
# reaches nothing. It stays in IME mode either way, which is the point: only
# the keyboard changes, not how text gets into the browser.
if grep -q '^[[:space:]]*\[input-method\]' "$OUT"; then
    echo "tessaro-weston-config: [input-method] already in $BASE, leaving it alone"
elif [ "$osk" = never ]; then
    printf '\n[input-method]\npath=\n' >> "$OUT"
    echo "tessaro-weston-config: on-screen keyboard off (KIOSK_OSK=never)"
elif [ "$osk" = always ]; then
    echo "tessaro-weston-config: on-screen keyboard on (KIOSK_OSK=always)"
elif hw_keyboard_present; then
    printf '\n[input-method]\npath=\n' >> "$OUT"
    echo "tessaro-weston-config: on-screen keyboard off (auto, keyboard attached)"
else
    echo "tessaro-weston-config: on-screen keyboard on (auto, no keyboard attached)"
fi

# Remote access, before the scale for the same reason the keyboard is: a
# KIOSK_SCALE=none device should still be reachable.
#
# What this section actually starts is a *second* Weston. Weston's VNC support
# is a backend, not an add-on, and this compositor is already on the DRM
# backend driving the panel - so there is no way to open a VNC port on it.
# screen-share.so (loaded from the unit drop-in) forks the command below, hands
# it one end of a socketpair, and presents this output into it through
# zwp_fullscreen_shell_v1; the child serves that surface over VNC and sends
# pointer and key events back, which screen-share injects into this
# compositor's own seat - the one Chromium binds - thanks to the weston
# bbappend's screen-share patch (see docs/remote-access.md).
#
# input= is that patch's key: false (KIOSK_VNC=view-only) never binds the
# child's seat, so the viewer sees the panel and nothing it sends arrives.
#
# start-on-startup=false: nothing is shared until tessaro-agent asks over
# screen-share.sock, when a VNC tunnel opens (the weston bbappend's fifth
# patch). Sharing an output makes Weston stop using hardware overlay and cursor
# planes for it and read every damage rectangle back out of the renderer, so a
# scroll costs a full-screen readback per frame; on demand, that is paid only
# while someone watches. KIOSK_VNC=off writes no section, and the agent refuses
# a tunnel.
#
# Flags, and why each one:
#
#   --backend=vnc-backend.so     the whole point. --address/--port are
#                                command line only; weston.ini's [vnc] section
#                                takes refresh-rate and the TLS paths, nothing
#                                that binds a socket.
#   --shell=fullscreen-shell.so  required. Without it the child does not
#                                advertise zwp_fullscreen_shell_v1 and the
#                                share fails with "Parent does not support
#                                wl_fullscreen_shell".
#   --no-config                  stops the child loading /etc/xdg/weston/
#                                weston.ini, finding a [screen-share] section
#                                and sharing itself, recursively.
#   --vnc-tls-cert/-key          not optional: the backend refuses to start
#                                without both. Clients log in over TLS
#                                (VeNCrypt) or, without TLS, with Apple's
#                                login; either is checked by tessaro-vnc-auth
#                                through PAM, against the image's
#                                KIOSK_VNC_USER/KIOSK_VNC_PASSWORD.
#   --vnc-password-file          the classic VNC password, which most viewers
#                                (macOS Screen Sharing, Royal TSX, RealVNC)
#                                log in with. PAM cannot check it - the
#                                server needs the password itself - so it is
#                                written to a file only the weston user reads.
#                                Only its first 8 characters count.
#
# Note what is *not* here: oe-core's stock command carries
# --no-clients-resize, which is an RDP backend option. An unrecognised option
# is fatal to the child, so it has to go.
#
# No --width/--height either. The child's output starts at the backend default
# and present_surface_for_mode switches it to this panel's mode as soon as the
# share is set up.
if grep -q '^[[:space:]]*\[screen-share\]' "$OUT"; then
    echo "tessaro-weston-config: [screen-share] already in $BASE, leaving it alone"
elif [ "$vnc" = off ]; then
    echo "tessaro-weston-config: remote access off (KIOSK_VNC=off)"
else
    if [ "$vnc" = view-only ]; then
        input=false
        how="view only"
    else
        input=true
        how="view and control"
    fi
    # The classic password only when the image has one; the child refuses to
    # start on an empty file. The file itself belongs to the real run only:
    # tessaro-agent runs this as root into a scratch config
    # (TESSARO_WESTON_CONFIG) just to compare, and must not touch what the
    # running mirror reads. Written whole, then moved, readable by its owner
    # alone.
    password_option=
    vnc_password=$(read_key "$DEFAULTS" KIOSK_VNC_PASSWORD)
    if [ -n "$vnc_password" ]; then
        password_option=" --vnc-password-file=$VNC_PASSWORD_FILE"
        if [ -z "${TESSARO_WESTON_CONFIG:-}" ]; then
            (
                umask 077
                printf '%s\n' "$vnc_password" > "$VNC_PASSWORD_FILE.new"
            )
            mv -f "$VNC_PASSWORD_FILE.new" "$VNC_PASSWORD_FILE"
        fi
    fi
    printf '\n[screen-share]\nstart-on-startup=false\ninput=%s\ncommand=%s\n' \
        "$input" \
        "/usr/bin/weston --backend=vnc-backend.so --shell=fullscreen-shell.so --no-config --address=$VNC_ADDRESS --port=$VNC_PORT --vnc-tls-cert=$VNC_TLS_CERT --vnc-tls-key=$VNC_TLS_KEY$password_option" \
        >> "$OUT"
    echo "tessaro-weston-config: remote access on ($how), VNC on $VNC_ADDRESS:$VNC_PORT"
fi

for dev in "$DRM_ROOT"/card*-*; do
    [ -r "$dev/status" ] || continue
    [ "$(cat "$dev/status")" = connected ] || continue

    # card0-HDMI-A-1 -> HDMI-A-1. Weston names outputs after the connector,
    # without the card prefix.
    name=${dev##*/}
    name=${name#*-}

    # A writeback connector (vc4 under full KMS has Writeback-1) is always
    # "connected" and has no modes: it captures a CRTC to memory, it is not a
    # screen, and Weston does not make a head of it.
    case $name in Writeback-*) continue ;; esac

    # An [output] section in the base file wins, including one a technician
    # added. Two cards can also expose the same connector name; the first
    # iteration writes it and this skips the rest.
    if grep -q "^[[:space:]]*name[[:space:]]*=[[:space:]]*$name[[:space:]]*$" "$OUT"; then
        echo "tessaro-weston-config: $name already configured, leaving it alone"
        continue
    fi

    # The mode, only if this connector lists it. A display that does not is
    # left on its preferred mode rather than driven out of range.
    mode=
    if [ "$resolution" != preferred ]; then
        if grep -qx "$resolution" "$dev/modes" 2>/dev/null; then
            mode=$resolution
        else
            echo "tessaro-weston-config: $name does not offer $resolution, keeping its preferred mode" >&2
        fi
    fi

    if [ "$scale_override" = none ]; then
        scale=
        why="KIOSK_SCALE=none"
    elif [ -n "$scale_override" ]; then
        scale=$scale_override
        why="KIOSK_SCALE"
    else
        # The mode being set, or else the first line of modes, which is the
        # connector's preferred one. The panel's own width, before any
        # transform=: a 4K panel turned to portrait still wants scale 2.
        if [ -n "$mode" ]; then
            width=${mode%%x*}
        else
            width=$(sed -n '1s/x.*//p' "$dev/modes" 2>/dev/null || true)
        fi
        scale=1
        # 3400 rather than 3840: it sits above every 2560-wide panel and below
        # every 4K one, including the 3440x1440 ultrawides.
        if [ -n "$width" ] && [ "$width" -ge 3400 ] 2>/dev/null; then
            scale=2
        fi
        why="auto from ${width:-unknown}px"
    fi

    # max-bpc=8 keeps the link on 8-bit RGB. Weston's default of 16 lets the
    # driver pick deep colour, and where the link cannot carry deep RGB, vc4
    # falls back to 12-bit YCbCr 4:2:2 in limited range: the monitor's
    # conversion back loses levels and dark gradients band. Nothing above
    # Weston renders more than 8 bits per channel, so deep colour gains nothing.
    printf '\n[output]\nname=%s\nmax-bpc=8\n' "$name" >> "$OUT"
    if [ -n "$scale" ]; then
        printf 'scale=%s\n' "$scale" >> "$OUT"
    fi
    if [ -n "$mode" ]; then
        printf 'mode=%s\n' "$mode" >> "$OUT"
    fi
    # Only when turned, so an unrotated device keeps the config it had and a
    # hotplug check sees no difference.
    if [ -n "$transform" ]; then
        printf 'transform=%s\n' "$transform" >> "$OUT"
    fi
    echo "tessaro-weston-config: $name scale=${scale:-default} mode=${mode:-preferred} transform=${transform:-normal} ($why)"
done
