# Point Weston at a generated config, so the output scale can follow the panel.
#
# See @libexecdir@/tessaro-weston-config for why the scale cannot
# come from the browser: Chromium's --force-device-scale-factor is inert on
# Weston 13, which does not implement wp_fractional_scale_manager_v1, so
# weston.ini's [output] scale= is the only lever there is.
#
# The knobs are screen.scale, screen.resolution, screen.rotation, screen.osk
# and screen.vnc, set with tessaro-ctl and rendered by tessaro-agent into
# /run/tessaro-kiosk/generated.env, which the generator reads over the image
# defaults. tessaro-agent restarts this unit when one of them changes, which
# takes the browser down and back up with it, since tessaro-kiosk.service is
# PartOf=weston.service. The agent itself keeps running.

[Unit]
# generated.env has to exist before the generator reads it. Wants=, not
# Requires=: without it the image defaults still make a working display.
Wants=tessaro-config.service
After=tessaro-config.service

[Service]
# Creates /run/weston owned by User= (weston) before ExecStartPre= runs, and
# removes it on stop. This is why the generator needs no privilege: it only
# reads world-readable /sys/class/drm and /etc, and writes here.
RuntimeDirectory=weston

ExecStartPre=@libexecdir@/tessaro-weston-config

# The empty assignment is required to clear oe-core's ExecStart= before adding
# ours; without it systemd appends and Weston is started twice. Note
# --modules=systemd-notify.so is carried over verbatim and is not optional -
# weston.service is Type=notify and hangs until its start timeout without it.
#
# screen-share.so is the remote-access half: it is what forks a second Weston
# on the VNC backend and mirrors this one into it. --modules is comma
# separated. The module is inert on its own - it does nothing until a
# [screen-share] section names a command, which tessaro-weston-config writes
# only when KIOSK_VNC is on. Its other trigger, a Ctrl+Alt+S key binding, is
# not reachable on a kiosk with no keyboard.
#
# tessaro-power.so (weston-tessaro-power) is `tessaro-ctl screen power`: a
# socket in /run/weston that switches the outputs off and on, which Weston
# offers through nothing else. See docs/display.md, "Screen power".
ExecStart=
ExecStart=@bindir@/weston --config=/run/weston/weston.ini --modules=systemd-notify.so,screen-share.so,tessaro-power.so
