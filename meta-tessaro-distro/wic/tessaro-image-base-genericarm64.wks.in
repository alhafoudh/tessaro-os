# short-description: EFI disk image for genericarm64 with a persistent /data
# long-description: the genericx86-64 layout (ESP, rootfs, /data) for Arm64
# machines that boot through UEFI: QEMU's virt machine with edk2, UTM and
# Apple's Hypervisor.framework on a Mac, and SystemReady boards. See
# tessaro-image-base-genericx86-64.wks.in for the reasoning behind each
# option; only the identifiers differ.
#
# The PARTUUIDs and the ESP's vfat serial are fixed and distinct from every
# other machine's, so an in-place update finds its own layout and the
# updater's layout check is a machine check. Changing any of them is a new
# disk layout: every device needs one full reflash before it can take updates
# again.

part /boot --source bootimg-efi --sourceparams="loader=${EFI_PROVIDER}" --ondisk sda --label boot --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --active --align 1024 --use-uuid --uuid 82b26a71-fee5-4af9-897f-07836e6bd8df --fsuuid 0x58BA9C95 --fixed-size ${TESSARO_ESP_SIZE}
part / --source rootfs --ondisk sda --fstype=ext4 --label platform --align 1024 --use-uuid --uuid d37ea071-f39f-49ae-bca0-0418c5c44de4 --fixed-size ${TESSARO_ROOTFS_SIZE}
part /data --ondisk sda --fstype=ext4 --size "${IMAGE_DATA_MIN_SIZE}" --label data --use-label --align 1024 --uuid 441422f9-2d35-452c-b4a5-00536fb75178

bootloader --ptable gpt --timeout=5 --append="rootwait rootfstype=ext4 console=ttyAMA0,115200 console=tty0"
