# Repositories cloned and checked out by kas. Their revisions are pinned in
# kas/*.yml, so they are build inputs rather than content of this repo.
/bitbake/
/openembedded-core/
/meta-moonforge/
/meta-openembedded/
/meta-raspberrypi/
/meta-yocto/
/meta-virtualization/
/meta-webkit/
/meta-rauc/
/meta-rauc-community/
/meta-lts-mixins/
/meta-browser/
/meta-clang/
/meta-lts-mixins-rust/
/meta-intel/

# Cargo's build tree for agent/. CARGO_TARGET_DIR in mise.toml points it at
# build/, out of the source tree, because the tessaro-kiosk recipe fetches
# agent/ with a file:// SRC_URI - bitbake would otherwise copy and checksum
# every object file in it on every build. This entry is the belt to that
# braces, for a cargo invoked without mise.
/agent/target/
# The same for gui/, whose tasks build into build/gui-target.
/gui/target/

# Webconfig's dependencies and its generated API types, remade by
# `mise run webconfig:setup` and `webconfig:gen`; its build goes to
# build/webconfig.
/webconfig/node_modules/
/webconfig/src/api/schema.d.ts
/webconfig/dist/

# The demo's dependencies, remade by `mise run demo:setup`; its build goes
# to build/demo.
/demo/node_modules/

# The README screenshot tool's Playwright, installed by
# `mise run docs:screenshots`.
/docs/screenshots/node_modules/

# Build output and shared caches. No trailing slash on cache: in a worktree
# it is a symlink to the main checkout's (CLAUDE.md), which `/cache/` misses.
/build/
/cache

# kas and bitbake scratch
/.config.yaml
/.kas_shell_history

# Per-workstation settings: build host, flash device, tunnel addresses
/mise.local.toml
# Per-user list of test devices and how to reach them (CLAUDE.md)
/DEV_MACHINES.txt

# Images pulled from the build host by `mise run image:pull`
/*.wic
/*.wic.*

/.claude/worktrees

# Per-user editor and Claude Code settings. Ignored here and not only in a
# global excludes file: the build runs git inside kas-container, which has no
# global git config, and any untracked file makes the image -dirty.
/.claude/settings.local.json
/.idea/
