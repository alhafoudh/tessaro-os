# Repositories cloned and checked out by kas. Their revisions are pinned in
# kas/*.yml, so they are build inputs rather than content of this repo.
/bitbake/
/openembedded-core/
/meta-moonforge/
/meta-openembedded/
/meta-raspberrypi/
/meta-yocto/
/meta-virtualization/
/meta-webkit/
/meta-rauc/
/meta-rauc-community/
/meta-lts-mixins/
/meta-browser/
/meta-clang/
/meta-lts-mixins-rust/
/meta-intel/

# Cargo's build tree for agent/. CARGO_TARGET_DIR in mise.toml points it at
# build/, out of the source tree, because the tessaro-kiosk recipe fetches
# agent/ with a file:// SRC_URI - bitbake would otherwise copy and checksum
# every object file in it on every build. This entry is the belt to that
# braces, for a cargo invoked without mise.
/agent/target/
# The same for gui/, whose tasks build into build/gui-target.
/gui/target/

# Build output and shared caches
/build/
/cache/

# kas and bitbake scratch
/.config.yaml
/.kas_shell_history

# Per-workstation settings: build host, flash device, tunnel addresses
/mise.local.toml

# Images pulled from the build host by `mise run image:pull`
/*.wic
/*.wic.*

/.claude/worktrees
