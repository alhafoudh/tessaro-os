# frozen_string_literal: true

source "https://rubygems.org"

ruby "~> 4.0"

# System bus access: restarting tessaro-kiosk.service via systemd1.
gem "ruby-dbus", "~> 0.25"

# CDP over WebSocket: a minimal client, no native extensions.
gem "websocket-client-simple", "~> 0.8"

# Autoloading: lib/tessaro/kiosk_watchdog/*.rb map to
# Tessaro::KioskWatchdog::* constants by file name.
gem "zeitwerk", "~> 2.6"

group :test do
  gem "minitest", "~> 5.20"
  gem "rake", "~> 13.0"
end
