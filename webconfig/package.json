{
  "name": "tessaro-webconfig",
  "private": true,
  "version": "1.0.0",
  "description": "Webconfig: a Tessaro device's management pages, served by the device itself (docs/webconfig.md).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "gen": "openapi-typescript ../agent/protocol/openapi.json -o src/api/schema.d.ts",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc --noEmit && vite build",
    "test": "npm run gen && vitest run",
    "lint": "npm run gen && tsc --noEmit && eslint . && prettier --check .",
    "lock": "node scripts/bitbake-lock.mjs",
    "lock:check": "node scripts/bitbake-lock.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "hash-wasm": "^4.12.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
